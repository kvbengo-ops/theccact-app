---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import { BRAND } from '../content/site.mjs';
import { SITE_BRAND } from '../lib/links.mjs';
import SiteHeader from '../components/SiteHeader.astro';
import PartnerStrip from '../components/PartnerStrip.astro';
import ContinuingEducationNotice from '../components/ContinuingEducationNotice.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  partner?: {
    slug: string;
    name: string;
    type?: string;
    image?: string;
    referralCode?: string;
  } | null;
}

const {
  title = `${BRAND.shortName} — ${BRAND.fullName}`,
  description = 'Online continuing education, nursing exam review, and Canadian health care training courses offered 100% online by CCACT.',
  activePage = '',
  partner = null,
} = Astro.props;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const resolvedTitle = partner ? `${title} · ${partner.name}` : title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    {partner && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={BRAND.logoSrc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Lato:wght@400;700&display=swap"
    />
  </head>
  <body data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="scroll-progress" aria-hidden="true"></div>

    <SiteHeader activePage={activePage} partner={partner} overlay={activePage === '' && !partner} />
    {partner && <PartnerStrip partner={partner} />}

    <main id="main-content" tabindex="-1">
      <slot />
      {/* Template-owned legal notice renders on every page and cannot be overridden by partner data. */}
      <ContinuingEducationNotice partner={partner} />
    </main>

    <SiteFooter partner={partner} />
    {/* ponytail: owner-edited text (admin > Content) is CCACT-only; per-brand keys if CCES needs its own. */}
    {SITE_BRAND === 'ccact' && supabaseUrl && supabaseKey && <script>import '../scripts/site-content.mjs';</script>}
  </body>
</html>
