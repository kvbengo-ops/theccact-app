---
import LearnLayout from '../../layouts/LearnLayout.astro';
import { PLATFORM_NAME } from '../../scripts/learn-brand.mjs';
---

<LearnLayout page="lesson" requiresAuth={true} title={`Lesson — ${PLATFORM_NAME}`}>
  <section class="band band--cream" aria-label="Lesson">
    <div class="container lp">
      <div id="lesson-missing" class="editorial-card" hidden>
        <h1 class="section-heading">Lesson not available</h1>
        <p class="section-lead">We could not find this lesson in your courses.</p>
        <a href="/learn/" class="btn btn--gold">Back to my courses</a>
      </div>
      <div id="lesson-locked" class="editorial-card" hidden>
        <h1 class="section-heading">This lesson is still locked</h1>
        <p class="section-lead">Finish the lesson before it to open this one.</p>
        <a href="/learn/" class="btn btn--gold">Back to my courses</a>
      </div>

      <div id="lesson-content" hidden>
        <p id="lesson-kicker" class="lp-kicker"></p>
        <h1 id="lesson-title" class="lp-title">Lesson</h1>
        <p><a id="lesson-course-link" href="/learn/" class="text-link">Back to the course</a></p>
        <p id="lesson-status" class="learn-alert" role="alert" hidden></p>
        <p id="lesson-video-note" class="editorial-card" hidden>The video for this lesson is not available yet.</p>

        <div id="lesson-listen" class="lp-listen" hidden>
          <button type="button" id="listen-play" class="btn btn--gold" aria-pressed="false">Listen to this lesson</button>
          <button type="button" id="listen-stop" class="btn btn--outline-navy" hidden>Stop</button>
          <label class="lp-listen__rate">Speed
            <select id="listen-rate">
              <option value="0.8">Slower</option>
              <option value="1" selected>Normal</option>
              <option value="1.2">Faster</option>
            </select>
          </label>
          <label class="lp-listen__auto"><input type="checkbox" id="listen-autoscroll" checked /> Auto-scroll</label>
        </div>
        <p class="lp-hl-tip">Tip: select any text to highlight or underline it.</p>

        <div class="lp-body">
          <div id="lesson-reading" class="lp-reading"></div>
          <aside id="lesson-stage" class="lp-stage" aria-label="Visual for this part"></aside>
        </div>

        <details id="lesson-terms" class="editorial-card lp-terms" hidden>
          <summary>Medical terms in this lesson</summary>
          <dl id="lesson-terms-list"></dl>
        </details>

        <div id="lp-hl-bar" class="lp-hl-bar" role="toolbar" aria-label="Mark selected text" hidden>
          <button type="button" data-hl="mark"><span class="lp-hl-swatch" aria-hidden="true"></span>Highlight</button>
          <button type="button" data-hl="under"><span class="lp-hl-under" aria-hidden="true">U</span>Underline</button>
          <button type="button" data-hl="remove">Remove</button>
        </div>

        <dialog id="lp-zoom" class="lp-zoom" aria-label="Image, full size"></dialog>

        <dialog id="lp-wrapup" class="lp-wrapup" aria-label="Wrap-up question"></dialog>

        <div id="lp-term-card" class="lp-term-card" popover role="dialog" aria-labelledby="lp-term-name">
          <p id="lp-term-name" class="lp-term-card__name"></p>
          <p id="lp-term-say" class="lp-say"></p>
          <p id="lp-term-def" class="lp-term-card__def"></p>
          <div class="lp-term-card__actions">
            <button type="button" id="lp-term-speak" class="btn btn--gold">Say it</button>
            <button type="button" class="btn btn--outline-navy" popovertarget="lp-term-card" popovertargetaction="hide" data-close>Close</button>
          </div>
        </div>

        <section id="lesson-exam" class="editorial-card lp-exam" aria-live="polite" hidden></section>

        <section id="lesson-check" class="editorial-card" aria-labelledby="lesson-check-title" hidden>
          <h2 id="lesson-check-title" class="lp-subtitle">Quick check</h2>
          <form id="lesson-check-form" novalidate></form>
          <p id="lesson-check-result" class="lp-result" role="status" tabindex="-1"></p>
        </section>

        <div id="lesson-footer" class="lp-actions"></div>
      </div>
    </div>
  </section>
</LearnLayout>
<script>import '../../scripts/learn-portal.mjs';</script>

<style is:global>
  .lp { max-width: 760px; overflow-wrap: anywhere; }
  .lp-stage { display: none; }
  @media (min-width: 1000px) {
    .lp.has-stage { max-width: 1240px; }
    .lp.has-stage .lp-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 40px; align-items: start; }
    .lp.has-stage .lp-stage { display: block; position: sticky; top: 96px; }
    .lp.has-stage .lp-reading .lp-figure, .lp.has-stage .lp-reading .lp-deck--inline { display: none; }
  }
  .lp-stage__item { animation: lp-stage-in 0.55s ease both; }
  @keyframes lp-stage-in { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }
  .lp-figure.is-photo:not(.is-waiting) img { animation: lp-photo-zoom 16s ease-in-out infinite alternate; }
  @keyframes lp-photo-zoom { from { transform: scale(1); } to { transform: scale(1.06); } }

  /* Step slide decks */
  .lp-deck { margin: 4px 0 24px; padding: 16px; border: 1px solid var(--color-border); border-radius: 14px; background: var(--surface); white-space: normal; outline: none; }
  .lp-deck:focus-visible { box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-gold) 45%, transparent); }
  .lp-deck--inline { position: sticky; top: 80px; z-index: 5; box-shadow: 0 12px 24px -18px rgb(10 15 30 / 0.5); }
  .lp-deck__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 10px; }
  .lp-deck__title { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-gold-dark); }
  .lp-deck__count { font-size: 13px; font-weight: 700; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .lp-deck__window { overflow: hidden; border-radius: 10px; }
  .lp-deck__track { display: flex; transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1); touch-action: pan-y; cursor: grab; }
  .lp-deck__slide { flex: 0 0 100%; min-height: 150px; padding: 20px 22px; border-radius: 10px; background: linear-gradient(135deg, var(--color-navy), color-mix(in srgb, var(--color-navy) 75%, var(--color-gold))); color: #fff; }
  .lp-deck__num { display: inline-grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--color-gold); color: var(--color-navy); font-weight: 800; }
  .lp-deck__step { margin: 12px 0 6px; font-family: var(--font-serif); font-size: 24px; font-weight: 700; line-height: 1.2; }
  .lp-deck__body { margin: 0; font-size: 16px; line-height: 1.55; color: rgb(255 255 255 / 0.9); }
  .lp-deck__slide.is-current .lp-deck__num { animation: lp-pop 0.5s ease; }
  .lp-deck__slide.is-current .lp-deck__step, .lp-deck__slide.is-current .lp-deck__body { animation: lp-rise 0.5s ease both; }
  .lp-deck__slide.is-current .lp-deck__body { animation-delay: 0.08s; }
  @keyframes lp-pop { 0% { transform: scale(0.6); } 70% { transform: scale(1.12); } 100% { transform: scale(1); } }
  @keyframes lp-rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .lp-deck__foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 12px; }
  .lp-deck__nav { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--color-border); border-radius: 50%; background: var(--surface); color: var(--ink); cursor: pointer; }
  .lp-deck__nav:disabled { opacity: 0.35; cursor: default; }
  .lp-deck__nav svg { width: 18px; height: 18px; }
  .lp-deck__dots { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .lp-deck__dot { width: 10px; height: 10px; padding: 0; border: 0; border-radius: 50%; background: var(--color-border); cursor: pointer; transition: transform 0.2s ease, background 0.2s ease; }
  .lp-deck__dot[aria-selected='true'] { background: var(--color-gold); transform: scale(1.3); }
  .lp-reading .lp-step { position: relative; padding-left: 40px; }
  .lp-reading .lp-step::before { content: attr(data-step); position: absolute; left: 0; top: 2px; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--color-sand); color: var(--color-gold-dark); font-size: 14px; font-weight: 800; }
  @media (prefers-reduced-motion: reduce) {
    .lp-stage__item, .lp-figure.is-photo img, .lp-deck__slide.is-current *, .lp-deck__track { animation: none !important; transition: none !important; }
  }
  .lp-kicker { margin: 0 0 6px; font-size: 14px; font-weight: 700; color: var(--color-text-muted); }
  .lp-title { margin: 0 0 8px; font-family: var(--font-serif); font-size: clamp(1.9rem, 5vw, 2.7rem); line-height: 1.12; color: var(--ink); }
  .lp-subtitle { margin: 0 0 16px; font-family: var(--font-serif); font-size: 26px; color: var(--ink); }
  .lp-reading { font-size: 17px; line-height: 1.7; white-space: pre-line; margin-bottom: 28px; }
  .lp-reading .lp-h { margin: 28px 0 8px; font-family: var(--font-serif); font-size: 24px; line-height: 1.2; color: var(--ink); white-space: normal; }
  .lp-reading > p, .lp-reading > .lp-h, .lp-title { border-radius: 6px; transition: background-color 0.2s ease, box-shadow 0.2s ease; }
  .is-reading { background: color-mix(in srgb, var(--color-gold) 18%, transparent); box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-gold) 18%, transparent); }

  /* Listen bar */
  .lp-listen { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin: 4px 0 22px; }
  .lp-listen .btn { gap: 8px; min-height: 44px; }
  .lp-listen svg, .lp-term-card svg, .lp-speak svg { width: 18px; height: 18px; flex-shrink: 0; }
  .lp-listen__rate { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; color: var(--color-text-muted); }
  .lp-listen__rate select { min-height: 40px; padding: 0 10px; border: 1px solid var(--color-border); border-radius: 8px; background: var(--surface); color: var(--ink); font: inherit; }

  /* Medical terms: dotted underline, tap for the card */
  .lp-term { display: inline; padding: 0; border: 0; background: none; font: inherit; color: inherit; text-decoration: underline dotted var(--color-gold-dark) 2px; text-underline-offset: 4px; cursor: help; }
  .lp-term:hover, .lp-term:focus-visible { color: var(--color-gold-dark); }
  .lp-say { margin: 0; font-style: italic; color: var(--color-gold-dark); }
  .lp-term-card { position: fixed; inset: auto 16px 16px; width: auto; max-width: 520px; margin: 0 auto; padding: 18px 20px; border: 1px solid var(--color-border); border-radius: 14px; background: var(--surface); color: var(--color-text); box-shadow: 0 24px 48px -16px rgb(10 15 30 / 0.45); }
  .lp-term-card__name { margin: 0; font-family: var(--font-serif); font-size: 24px; font-weight: 700; color: var(--ink); }
  .lp-term-card__def { margin: 8px 0 14px; line-height: 1.55; }
  .lp-term-card__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .lp-term-card__actions .btn { gap: 8px; min-height: 44px; }
  .lp-terms { margin-bottom: 28px; }
  .lp-terms summary { cursor: pointer; font-weight: 700; color: var(--ink); min-height: 32px; }
  .lp-terms dl { margin: 12px 0 0; }
  .lp-terms dt { display: flex; align-items: center; gap: 6px; margin-top: 12px; font-weight: 700; color: var(--ink); }
  .lp-terms dd { display: grid; gap: 2px; margin: 2px 0 0; }
  .lp-speak { display: inline-grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 50%; background: none; color: var(--color-gold-dark); cursor: pointer; }
  .lp-speak:hover { background: var(--color-sand); }
  .lp-question { border: 0; padding: 0; margin: 0 0 24px; min-width: 0; }
  .lp-question legend { font-weight: 700; color: var(--ink); margin-bottom: 8px; padding: 0; }
  .lp-hint { margin: 0 0 8px; font-size: 14px; color: var(--color-text-muted); }
  .lp-option { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 8px 12px; margin-bottom: 8px; border: 1px solid var(--color-border); background: var(--surface); cursor: pointer; }
  .lp-option input { width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--color-navy); }
  .lp-option:focus-within { outline: 2px solid var(--color-gold); outline-offset: 2px; }
  .lp-feedback { padding: 12px 16px; border-left: 4px solid var(--color-success); background: var(--color-sand); }
  .lp-feedback.is-wrong { border-left-color: var(--color-error); }
  .lp-feedback p { margin: 6px 0 0; }
  .lp-result { font-weight: 700; color: var(--ink); }

  /* Recall and wrap-up questions */
  .lp-recall { margin: 0 0 24px; padding: 18px 20px; border: 1px solid var(--color-border); border-left: 4px solid var(--color-gold); border-radius: 10px; background: var(--surface); white-space: normal; }
  .lp-recall__kicker { margin: 0 0 4px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-gold-dark); }
  .lp-recall__q { margin: 0 0 12px; font-weight: 700; color: var(--ink); line-height: 1.5; }
  .lp-recall__choices { display: flex; flex-wrap: wrap; gap: 8px; }
  .lp-recall__choice { min-height: 44px; padding: 8px 16px; border: 1px solid var(--color-border); border-radius: 8px; background: var(--surface); color: var(--ink); font: inherit; font-size: 15px; cursor: pointer; }
  .lp-recall__choice:hover:not(:disabled) { border-color: var(--ink); }
  .lp-recall__choice:disabled { cursor: default; opacity: 0.75; }
  .lp-recall__choice.is-right { opacity: 1; border-color: var(--color-success); box-shadow: inset 0 0 0 1px var(--color-success); font-weight: 700; }
  .lp-recall__choice.is-wrong { opacity: 1; border-color: var(--color-error); text-decoration: line-through; }
  .lp-recall__timer { display: flex; align-items: center; gap: 10px; margin-top: 12px; font-size: 13px; font-weight: 700; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .lp-recall__track { flex: 1; height: 6px; border-radius: 999px; background: var(--color-sand); overflow: hidden; }
  .lp-recall__bar { display: block; height: 100%; background: var(--color-gold); transition: width 0.2s linear; }
  .lp-recall__why:empty { display: none; }
  .lp-question-mark { height: 1px; }
  .lp-listen__auto { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 700; color: var(--color-text-muted); cursor: pointer; }
  .lp-listen__auto input { width: 18px; height: 18px; accent-color: var(--color-navy); }
  .lp-hl-tip { margin: -12px 0 20px; font-size: 13px; color: var(--color-text-muted); }
  mark.lp-hl { color: inherit; border-radius: 3px; }
  mark.lp-hl--mark { background: color-mix(in srgb, #f5d547 55%, transparent); }
  mark.lp-hl--under { background: none; text-decoration: underline 3px var(--color-gold-dark); text-underline-offset: 4px; }
  .lp-hl-bar { position: absolute; z-index: 60; display: flex; gap: 4px; padding: 6px; border-radius: 12px; background: var(--color-navy); box-shadow: 0 12px 28px -12px rgb(10 15 30 / 0.6); }
  .lp-hl-bar[hidden] { display: none; }
  .lp-hl-bar button { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 12px; border: 0; border-radius: 8px; background: none; color: #fff; font: inherit; font-size: 14px; font-weight: 700; cursor: pointer; }
  .lp-hl-bar button:hover, .lp-hl-bar button:focus-visible { background: rgb(255 255 255 / 0.14); }
  .lp-hl-swatch { width: 14px; height: 14px; border-radius: 3px; background: #f5d547; }
  .lp-hl-under { text-decoration: underline 2px #e3c98a; text-underline-offset: 3px; }
  .lp-figure { margin: 4px 0 28px; white-space: normal; }
  .lp-figure__frame { position: relative; overflow: hidden; border: 1px solid var(--color-border); border-radius: 10px; background: #fff; }
  .lp-figure img { display: block; width: 100%; height: auto; max-height: 460px; object-fit: contain; cursor: zoom-in; transition: opacity 0.7s ease, filter 0.7s ease, transform 0.7s ease; }
  .lp-figure__wait { position: absolute; inset: 0; display: grid; place-items: center; font-size: 14px; font-weight: 700; color: var(--color-text-muted); background: color-mix(in srgb, var(--color-sand) 70%, transparent); transition: opacity 0.5s ease; }
  .lp-figure:not(.is-waiting) .lp-figure__wait { opacity: 0; pointer-events: none; }
  .lp-figure.is-waiting img { opacity: 0.25; filter: blur(14px); transform: scale(0.97); cursor: default; }
  .lp-figure.is-waiting figcaption { opacity: 0; }
  .lp-figure figcaption { transition: opacity 0.7s ease; }
  @media (prefers-reduced-motion: reduce) { .lp-figure img, .lp-figure__wait, .lp-figure figcaption { transition: none; } .lp-figure.is-waiting img { transform: none; } }
  .lp-zoom { width: min(1100px, calc(100vw - 16px)); max-height: calc(100dvh - 16px); padding: 12px; border: 0; border-radius: 12px; background: #fff; }
  .lp-zoom::backdrop { background: rgb(10 14 24 / 0.8); }
  .lp-zoom img { display: block; width: 100%; height: auto; max-height: calc(100dvh - 110px); object-fit: contain; }
  .lp-zoom .btn { margin-top: 10px; }
  .lp-figure figcaption { margin-top: 8px; font-size: 14px; color: var(--color-text-muted); }
  .lp-recall__why { margin: 12px 0 0; line-height: 1.55; }
  .lp-wrapup { width: min(560px, calc(100vw - 24px)); padding: 20px; border: 0; border-radius: 14px; background: var(--surface); color: var(--color-text); }
  .lp-wrapup::backdrop { background: rgb(10 14 24 / 0.6); }
  .lp-wrapup .lp-recall { margin-bottom: 16px; border: 0; border-left: 4px solid var(--color-gold); padding: 4px 0 4px 16px; }

  /* Exam mode */
  .lp-exam__meta { font-weight: 700; color: var(--ink); }
  .lp-exam__bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--color-border); font-weight: 700; color: var(--color-text-muted); }
  .lp-exam__clock { font-variant-numeric: tabular-nums; color: var(--ink); }
  .lp-exam .lp-question legend { font-size: 18px; outline: none; }
  .lp-exam__review { padding-left: 20px; }
  .lp-exam__review li { margin-bottom: 18px; }
  .lp-exam__q { margin: 0 0 6px; font-weight: 700; color: var(--ink); }
  .lp-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 28px; }
  .lp-actions .btn { gap: 8px; }
  .lp-actions svg { width: 17px; height: 17px; }
</style>
