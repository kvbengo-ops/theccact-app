---
import LearnLayout from '../../layouts/LearnLayout.astro';
import { PLATFORM_NAME } from '../../scripts/learn-brand.mjs';
---

<LearnLayout
  page="verify"
  noindex={false}
  title={`Verify a certificate — ${PLATFORM_NAME}`}
  description="Check that a course certificate number is genuine."
>
  <section class="band band--cream" aria-labelledby="verify-title">
    <div class="container verify">
      <div class="editorial-card">
        <h1 id="verify-title" class="section-heading">Verify a certificate</h1>
        <p class="section-lead">Enter the number printed on the certificate.</p>
        <form method="get" class="verify__form">
          <label for="verify-number">Certificate number</label>
          <input id="verify-number" name="n" required maxlength="40" autocomplete="off" autocapitalize="characters" />
          <button type="submit" class="btn btn--gold">Verify</button>
        </form>
        <div id="verify-result" role="status" aria-live="polite"></div>
      </div>
    </div>
  </section>
</LearnLayout>
<script>import '../../scripts/learn-portal.mjs';</script>

<style is:global>
  .verify { max-width: 640px; overflow-wrap: anywhere; }
  .verify__form { display: grid; gap: 10px; margin-bottom: 20px; }
  .verify__form label { font-weight: 700; color: var(--ink); }
  .verify__form input { width: 100%; min-height: 48px; padding: 10px 14px; font: inherit; border: 1px solid var(--color-navy-outline); }
  .verify__form input:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 2px; }
  .lp-feedback { padding: 12px 16px; border-left: 4px solid var(--color-success); background: var(--color-sand); }
  .lp-feedback.is-wrong { border-left-color: var(--color-error); }
  .lp-feedback p { margin: 6px 0 0; }
</style>
