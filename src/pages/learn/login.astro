---
import LearnLayout from '../../layouts/LearnLayout.astro';
import Icon from '../../components/Icon.astro';
import LearnGoogleButton from '../../components/LearnGoogleButton.astro';
import { BRAND } from '../../content/site.mjs';
import { PLATFORM_NAME, WEBSITE } from '../../scripts/learn-brand.mjs';
---

<LearnLayout
  page="login"
  title={`Student Sign In — ${PLATFORM_NAME}`}
  description={`Sign in to your ${BRAND.shortName} online courses with an email sign-in link.`}
>
  <div class="auth">
    <!-- Depth: soft light sources behind frosted glass. Colors come from the active theme. -->
    <div class="auth__light auth__light--a" aria-hidden="true"></div>
    <div class="auth__light auth__light--b" aria-hidden="true"></div>
    <div class="auth__light auth__light--c" aria-hidden="true"></div>

    <div class="auth__card">
      <span class="auth__crest" aria-hidden="true"><img src={BRAND.logoSrc} alt="" width="44" height="44" /></span>
      <h1 class="auth__title">Welcome back</h1>
      <p class="auth__lead">Sign in to {PLATFORM_NAME}</p>

      <p id="learn-login-error" class="learn-alert" role="alert" hidden></p>

      <LearnGoogleButton />

      <form id="learn-login-form" class="auth__form" novalidate>
        <div class="learn-field">
          <label for="learn-email">Email address</label>
          <input id="learn-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
        </div>
        <button type="submit" class="btn btn--gold auth__submit">Email me a sign-in link</button>
        <button type="button" id="learn-use-password" class="learn-login-swap">Use a password instead</button>
      </form>

      <form id="learn-password-form" class="auth__form" novalidate hidden>
        <div class="learn-field">
          <label for="learn-pw-email">Email address</label>
          <input id="learn-pw-email" name="email" type="email" autocomplete="username" inputmode="email" required />
        </div>
        <div class="learn-field">
          <label for="learn-pw">Password</label>
          <input id="learn-pw" name="password" type="password" autocomplete="current-password" required />
          <small>No password yet? Use an email link, then create one in Settings.</small>
        </div>
        <button type="submit" class="btn btn--gold auth__submit">Sign in</button>
        <button type="button" id="learn-use-link" class="learn-login-swap">Email me a link instead</button>
      </form>

      <div id="learn-login-sent" class="auth__sent" tabindex="-1" role="status" aria-live="polite" hidden>
        <span class="auth__sent-icon"><Icon name="mail" /></span>
        <h2 class="auth__sent-title">Check your email</h2>
        <p>If <strong id="learn-sent-email"></strong> is enrolled, a sign-in link is on its way. Check spam if it is not there in a few minutes.</p>
        <button type="button" id="learn-login-reset" class="learn-login-swap">Use a different email</button>
      </div>
    </div>

    <p class="auth__foot">
      <a href={`${WEBSITE}/courses/`}>Browse courses</a>
      <span aria-hidden="true">·</span>
      <a href={`mailto:${BRAND.contactEmail}`}>Get help</a>
      <span aria-hidden="true">·</span>
      <a href={`${WEBSITE}/privacy/`}>Privacy</a>
    </p>
  </div>
</LearnLayout>
<script>import '../../scripts/learn-portal.mjs';</script>

<style is:global>
  .auth {
    --glass: color-mix(in srgb, var(--surface) 58%, transparent);
    --glass-edge: rgb(255 255 255 / 0.65);
    --glass-shine: rgb(255 255 255 / 0.7);
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 18px;
    min-height: calc(100dvh - 72px);
    padding: 48px 18px;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 50% 0%, color-mix(in srgb, var(--color-navy) 14%, transparent), transparent 60%),
      var(--color-cream);
  }

  html[data-theme='dark'] .auth {
    --glass: color-mix(in srgb, var(--surface) 55%, transparent);
    --glass-edge: rgb(255 255 255 / 0.12);
    --glass-shine: rgb(255 255 255 / 0.08);
  }

  /* Blurred light sources give the glass something to refract. */
  .auth__light {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    pointer-events: none;
  }

  .auth__light--a {
    width: 420px;
    height: 420px;
    top: 6%;
    left: calc(50% - 380px);
    background: var(--color-gold);
  }

  .auth__light--b {
    width: 480px;
    height: 480px;
    bottom: -8%;
    left: calc(50% + 20px);
    background: var(--color-navy-elevated);
    opacity: 0.6;
  }

  .auth__light--c {
    width: 260px;
    height: 260px;
    top: 38%;
    left: calc(50% + 160px);
    background: var(--color-gold-light);
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .auth__light--a { animation: auth-drift 18s ease-in-out infinite alternate; }
    .auth__light--b { animation: auth-drift 22s ease-in-out infinite alternate-reverse; }
  }

  @keyframes auth-drift {
    to { transform: translate(40px, 30px) scale(1.08); }
  }

  .auth__card {
    position: relative;
    width: min(420px, 100%);
    padding: 36px 32px 28px;
    border: 1px solid var(--glass-edge);
    border-radius: 22px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    backdrop-filter: blur(22px) saturate(160%);
    box-shadow:
      inset 0 1px 0 var(--glass-shine),
      0 2px 6px -2px rgb(10 15 30 / 0.12),
      0 24px 48px -20px rgb(10 15 30 / 0.35),
      0 60px 120px -40px rgb(10 15 30 / 0.3);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .auth__crest {
    display: inline-grid;
    place-items: center;
    width: 68px;
    height: 68px;
    margin-bottom: 14px;
    border: 1px solid var(--glass-edge);
    border-radius: 50%;
    background: linear-gradient(160deg, var(--color-navy-elevated), var(--color-navy));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), 0 10px 24px -10px rgb(10 15 30 / 0.5);
  }

  .auth__crest img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .learn-body .auth__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 600;
    line-height: 1.1;
  }

  .auth__lead {
    margin: 6px 0 24px;
    color: var(--color-text-muted);
  }

  .auth__card .learn-alert {
    text-align: left;
  }

  .auth__form {
    display: grid;
    gap: 14px;
    text-align: left;
  }

  .auth__card .learn-field input {
    min-height: 48px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--surface) 85%, transparent);
  }

  .auth__card .learn-field input:focus-visible {
    border-color: var(--color-gold);
    outline: 3px solid color-mix(in srgb, var(--color-gold) 35%, transparent);
    outline-offset: 0;
  }

  .auth__submit {
    min-height: 48px;
    border-radius: 10px;
    box-shadow: 0 10px 22px -12px color-mix(in srgb, var(--color-gold) 90%, transparent);
  }

  .auth__card .learn-google {
    min-height: 48px;
    border-radius: 10px;
    box-shadow: 0 6px 16px -10px rgb(10 15 30 / 0.35);
  }

  .auth__sent {
    display: grid;
    justify-items: center;
    gap: 8px;
  }

  .auth__sent p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .auth__sent-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-gold) 22%, transparent);
    color: var(--color-gold-dark);
  }

  .auth__sent-icon svg {
    width: 24px;
    height: 24px;
  }

  .learn-body .auth__sent-title {
    margin: 4px 0 0;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 700;
  }

  .auth__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 10px;
    margin: 0;
    font-size: 13.5px;
    color: var(--color-text-muted);
  }

  .learn-body .auth__foot a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .learn-body .auth__foot a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* Layout rules above set display; keep [hidden] states hidden. */
  .auth [hidden] {
    display: none !important;
  }

  /* High contrast: no transparency or blur. */
  html[data-theme='contrast'] .auth__card {
    background: var(--surface);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-color: var(--color-border);
  }

  html[data-theme='contrast'] .auth__light {
    display: none;
  }

  @media (max-width: 480px) {
    .auth { padding: 28px 14px; align-content: start; }
    .auth__card { padding: 28px 20px 22px; border-radius: 18px; }
    .learn-body .auth__title { font-size: 30px; }
    .auth__light--a { left: -160px; }
    .auth__light--b { left: 40px; }
    .auth__light--c { display: none; }
  }
</style>
