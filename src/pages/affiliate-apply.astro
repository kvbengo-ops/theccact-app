---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';

const options = [
  {
    href: '/affiliate-apply/individual/',
    icon: 'user',
    shape: 'circle',
    title: 'Individual affiliate',
    audience: 'Internationally educated nurses, graduates, educators and community connectors.',
    gets: ['Your own CCACT affiliate site', 'Bio, portrait and languages', 'Personal referral links'],
    cta: 'Apply as an individual',
  },
  {
    href: '/affiliate-apply/organisation/',
    icon: 'building',
    shape: 'square',
    title: 'Organization affiliate',
    audience: 'Immigration consultancies, education agencies, nursing schools and healthcare recruiters.',
    gets: ['A dedicated organization site', 'Logo, description and website', 'Named contact and referral links'],
    cta: 'Apply as an organization',
  },
];
---

<BaseLayout title="Apply as an affiliate — CCACT" activePage="affiliates">
  <PageHero eyebrow="CCACT affiliates" title="Become a CCACT affiliate" lead="Choose the application that fits you. Each one asks only for the details we need." />
  <section class="band band--sand" aria-labelledby="choose-heading">
    <div class="container">
      <h2 id="choose-heading" class="section-heading">Who is applying?</h2>
      <div class="choose">
        {options.map((o) => (
          <a href={o.href} class="choose__card">
            <span class:list={['choose__badge', `choose__badge--${o.shape}`]} aria-hidden="true"><Icon name={o.icon} /></span>
            <span class="choose__title">{o.title}</span>
            <span class="choose__audience">{o.audience}</span>
            <span class="choose__gets">
              {o.gets.map((g) => <span><Icon name="check" />{g}</span>)}
            </span>
            <span class="choose__cta">{o.cta} <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
      <p class="choose__login">Already applied? <a href="/affiliate/login/">Sign in to check your status</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .choose { margin-top: 28px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .choose__card { display: flex; flex-direction: column; gap: 12px; padding: 32px; background: var(--color-white); border: 1px solid var(--color-border); border-radius: 8px; text-decoration: none; color: var(--color-text); transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  .choose__card:hover, .choose__card:focus-visible { border-color: var(--color-gold); box-shadow: 0 14px 32px rgba(21, 35, 62, 0.1); color: var(--color-text); }
  .choose__badge { display: grid; place-items: center; width: 64px; height: 64px; background: var(--color-navy); color: var(--color-gold-light); }
  .choose__badge--circle { border-radius: 50%; }
  .choose__badge--square { border-radius: 14px; }
  .choose__badge :global(svg) { width: 30px; height: 30px; }
  .choose__title { margin-top: 6px; font-family: var(--font-serif); font-size: 32px; font-weight: 700; line-height: 1.1; color: var(--color-navy); font-size-adjust: 0.44; }
  .choose__audience { font-size: 15.5px; line-height: 1.6; color: var(--color-text-muted); }
  .choose__gets { display: grid; gap: 8px; padding-top: 14px; border-top: 1px solid var(--color-border); flex-grow: 1; }
  .choose__gets span { display: flex; align-items: flex-start; gap: 10px; font-size: 15.5px; }
  .choose__gets :global(svg) { width: 18px; height: 18px; margin-top: 3px; flex-shrink: 0; color: var(--color-gold-dark); stroke-width: 2.25; }
  .choose__cta { margin-top: 10px; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 16px; font-weight: 700; color: var(--color-navy); }
  .choose__cta :global(svg) { width: 18px; height: 18px; transition: transform 0.2s ease; }
  .choose__card:hover .choose__cta :global(svg) { transform: translateX(4px); }
  .choose__login { margin: 24px 0 0; font-size: 15.5px; }
  .choose__login a { font-weight: 700; }
  @media (max-width: 760px) { .choose { grid-template-columns: 1fr; } .choose__card { padding: 24px; } }
</style>
