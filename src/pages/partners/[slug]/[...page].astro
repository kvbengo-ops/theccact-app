---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HomePage from '../../../components/HomePage.astro';
import AboutPage from '../../../components/AboutPage.astro';
import CoursesPage from '../../../components/CoursesPage.astro';
import RegistrationPage from '../../../components/RegistrationPage.astro';
import StudyInCanadaPage from '../../../components/StudyInCanadaPage.astro';
import FaqPage from '../../../components/FaqPage.astro';
import ContactPage from '../../../components/ContactPage.astro';
import PrivacyPage from '../../../components/PrivacyPage.astro';
import PartnerAboutPage from '../../../components/PartnerAboutPage.astro';
import { ABOUT_PAGE, COURSES_PAGE, REGISTRATION_PAGE, STUDY_IN_CANADA_PAGE, FAQ_PAGE, CONTACT_PAGE, PRIVACY_PAGE } from '../../../content/pages.mjs';
import { loadLivePartners } from '../../../lib/partner-source.mjs';

const pages = {
  '': { component: HomePage, title: 'CCACT' },
  about: { component: AboutPage, ...ABOUT_PAGE },
  courses: { component: CoursesPage, ...COURSES_PAGE },
  registration: { component: RegistrationPage, ...REGISTRATION_PAGE },
  'study-in-canada': { component: StudyInCanadaPage, ...STUDY_IN_CANADA_PAGE },
  faq: { component: FaqPage, ...FAQ_PAGE },
  'about-partner': { component: PartnerAboutPage, title: 'About our partner' },
  contact: { component: ContactPage, ...CONTACT_PAGE },
  privacy: { component: PrivacyPage, ...PRIVACY_PAGE },
};

export async function getStaticPaths() {
  const url = import.meta.env.SUPABASE_URL ?? process.env.SUPABASE_URL;
  const key = import.meta.env.SUPABASE_SERVICE_ROLE_KEY ?? process.env.SUPABASE_SERVICE_ROLE_KEY;
  // Dev: the fictional fixture, plus every real page except retired ones (incl. suspended) when the server key is set in .env.local.
  // Real partners are flagged isPreview so their enrolment links stay disabled locally.
  const partners = import.meta.env.DEV
    ? [
        { ...(await import('../../../content/fixtures/partner-preview.mjs')).FIXTURE_INDIVIDUAL_PARTNER },
        ...(url && key ? (await loadLivePartners({ url, key, statuses: ['draft', 'review', 'preview', 'live', 'suspended'] })).map(p => ({ ...p, isPreview: true })) : []),
      ]
    : await loadLivePartners({ url, key, required: Boolean(import.meta.env.CF_PAGES || process.env.CF_PAGES) });
  return partners.flatMap(partner => ['', 'about', 'courses', 'registration', 'study-in-canada', 'faq', 'about-partner', 'contact', 'privacy'].map(page => ({
    params: { slug: partner.slug, page: page || undefined },
    props: { partner, page },
  })));
}

const { partner, page } = Astro.props;
const { component: Page, title, description } = pages[page];
---

<BaseLayout title={title} description={description} activePage={page} partner={partner}>
  {partner.isFixture && <p role="status" style="padding: 1rem; text-align: center; background: #ffeaa0; color: #222;">Test website — this partner is fictional and enrolment links are disabled.</p>}
  {partner.isPreview && <p role="status" style="padding: 1rem; text-align: center; background: #ffeaa0; color: #222;">Local preview ({partner.status}) — only visible on your computer; enrolment links are disabled.</p>}
  <Page partner={partner} />
</BaseLayout>
