---
import { PRIVACY_PAGE } from '../content/pages.mjs';
import PageHero from './PageHero.astro';
---

<PageHero
  eyebrow={PRIVACY_PAGE.hero.eyebrow}
  title={PRIVACY_PAGE.hero.title}
  lead={PRIVACY_PAGE.hero.lead}
/>

<section class="band band--white" aria-label="Privacy Notice sections">
  <div class="container privacy-container">
    {PRIVACY_PAGE.sections.map((section) => (
      <article class="privacy-section">
        <h2 class="section-heading privacy-heading">{section.heading}</h2>
        {section.paragraphs?.map((paragraph) => (
          <p class="privacy-paragraph">{paragraph}</p>
        ))}
        {section.orderedList && (
          <ol class="privacy-list">
            {section.orderedList.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        )}
        {section.unorderedList && (
          <ul class="privacy-list">
            {section.unorderedList.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .privacy-container {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .privacy-section {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .privacy-section:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .privacy-heading {
    font-size: 24px;
    margin-bottom: 12px;
  }

  .privacy-paragraph {
    margin: 0 0 12px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .privacy-paragraph:last-child {
    margin-bottom: 0;
  }

  .privacy-list {
    margin: 10px 0 0;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-text-muted);
  }
</style>
