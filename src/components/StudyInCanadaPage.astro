---
import { STUDY_IN_CANADA_PAGE } from '../content/pages.mjs';
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';

// ponytail: figures repeat facts already in the bio copy; update here if the bio changes.
const credentials = [
  { icon: 'shield', big: 'Since 2016', small: 'Licensed Canadian Immigration Consultant' },
  { icon: 'globe', big: '35+ years', small: 'Working with international students' },
  { icon: 'cap', big: '25 years', small: 'President & co-founder, Robetech Institute' },
] as const;
---

<PageHero
  eyebrow={STUDY_IN_CANADA_PAGE.hero.eyebrow}
  title={STUDY_IN_CANADA_PAGE.hero.title}
  lead={STUDY_IN_CANADA_PAGE.hero.lead}
/>

<section class="band band--white" aria-labelledby="jean-bio-heading">
  <div class="container bio-grid">
    <div class="bio-photo-card">
      <img
        src={STUDY_IN_CANADA_PAGE.portrait.src}
        alt={STUDY_IN_CANADA_PAGE.portrait.alt}
        width={STUDY_IN_CANADA_PAGE.portrait.width}
        height={STUDY_IN_CANADA_PAGE.portrait.height}
        class="bio-photo"
        decoding="async"
      />
    </div>

    <div class="bio-content">
      <h2 id="jean-bio-heading" class="section-heading">
        {STUDY_IN_CANADA_PAGE.greeting}
      </h2>
      <div class="prose-stack">
        {STUDY_IN_CANADA_PAGE.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <p class="bio-signoff">{STUDY_IN_CANADA_PAGE.signoff}</p>
      <div class="bio-actions">
        <a
          href={STUDY_IN_CANADA_PAGE.websiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--gold"
        >
          {STUDY_IN_CANADA_PAGE.websiteLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<section class="band band--sand" aria-labelledby="jean-exp-heading">
  <div class="container narrow-container">
    <h2 id="jean-exp-heading" class="section-heading">
      {STUDY_IN_CANADA_PAGE.experienceHeading}
    </h2>
    <p class="section-lead">{STUDY_IN_CANADA_PAGE.experienceBody}</p>
    <ul class="credentials">
      {credentials.map((c) => (
        <li class="credential">
          <span class="credential__badge"><Icon name={c.icon} /></span>
          <span class="credential__text">
            <strong>{c.big}</strong>
            <span>{c.small}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="band band--navy" aria-labelledby="jean-contact-heading">
  <div class="container contact-band">
    <div class="contact-band__copy">
      <h2 id="jean-contact-heading" class="section-heading section-heading--light">
        {STUDY_IN_CANADA_PAGE.contactHeading}
      </h2>
      <p class="contact-band__lead">{STUDY_IN_CANADA_PAGE.separationNotice}</p>
    </div>

    <div class="contact-band__actions">
      <a href={`mailto:${STUDY_IN_CANADA_PAGE.email}`} class="btn btn--gold contact-btn">
        <Icon name="mail" class="contact-icon" />{STUDY_IN_CANADA_PAGE.email}
      </a>
      <p class="contact-band__phone">
        <Icon name="phone" class="contact-icon" />{STUDY_IN_CANADA_PAGE.textPhone}
      </p>
      <a
        href={STUDY_IN_CANADA_PAGE.websiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--outline-light"
      >
        {STUDY_IN_CANADA_PAGE.websiteLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .bio-grid {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: 44px;
    align-items: start;
  }

  .bio-photo-card {
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    padding: 12px;
  }

  .bio-photo {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .prose-stack {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15.5px;
    line-height: 1.66;
    color: var(--color-text-muted);
  }

  .prose-stack p {
    margin: 0;
  }

  .bio-signoff {
    margin: 18px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    color: var(--color-navy);
    font-weight: 600;
  }

  .bio-actions {
    margin-top: 24px;
  }

  .narrow-container {
    max-width: 840px;
  }

  .contact-band {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
  }

  .contact-band__copy {
    flex: 1 1 420px;
  }

  .contact-band__lead {
    margin: 0;
    color: var(--color-on-dark);
    font-size: 15.5px;
    line-height: 1.62;
  }

  .contact-band__actions {
    flex: 0 1 320px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .credentials {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .credential {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
  }

  .credential__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-gold-light);
    flex-shrink: 0;
  }

  .credential__badge :global(svg) {
    width: 24px;
    height: 24px;
  }

  .credential__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14.5px;
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .credential__text strong {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.1;
    color: var(--color-navy);
    font-size-adjust: 0.44;
  }

  .contact-btn,
  .contact-band__phone {
    gap: 10px;
  }

  .contact-btn :global(.contact-icon),
  .contact-band__phone :global(.contact-icon) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .contact-band__phone {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 12px 18px;
    border: 1px solid var(--color-navy-card-border);
    background: var(--color-navy-elevated);
    color: var(--color-on-dark);
    text-align: center;
    font-size: 14.5px;
  }

  @media (max-width: 820px) {
    .credentials {
      grid-template-columns: 1fr;
    }

    .bio-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .bio-photo-card {
      max-width: 340px;
    }
  }
</style>
