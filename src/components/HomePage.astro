---
import { pageUrl } from '../lib/links.mjs';
import {
  HOME_COURSES_INTRO,
  HOME_HERO,
  HOME_PROGRAMMES,
  TEACHABLE_CATALOG_URL,
} from '../content/site.mjs';
import EnrolLink from './EnrolLink.astro';
import Icon from './Icon.astro';
import PartnerIntro from './PartnerIntro.astro';
import HomeSections from './HomeSections.astro';

interface Props {
  partner?: { slug: string; name: string; referralCode?: string } | null;
}

const { partner = null } = Astro.props;
const programmeIcons: Record<string, string> = {
  gerontology: 'users',
  crner: 'clipboard',
  chs: 'landmark',
  hpc: 'heart',
  dm: 'activity',
  esl: 'message',
};
const registrationHref = pageUrl('registration', partner);
// One icon per 'why study' point, in order.
const whyIcons = ['clock', 'globe', 'landmark', 'cap'];
---

<section class="hero" aria-labelledby="home-hero-heading">
  {/* Brand film: CCES builds swap /media/hero-ccact for /media/hero-cces (CCES_REWRITES). */}
  <div class="hero__media" aria-hidden="true">
    <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster="/media/hero-ccact.webp" src="/media/hero-ccact.mp4"></video>
  </div>
  <button type="button" class="hero__motion-toggle" aria-pressed="false" aria-label="Pause background video">
    <svg class="hero__icon-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
    <svg class="hero__icon-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13l11-6.5z" /></svg>
  </button>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">{HOME_HERO.eyebrow}</p>
      <h1 id="home-hero-heading" class="hero__title">
        {HOME_HERO.headlineLine1}
        <br />
        <em class="hero__title-em">{HOME_HERO.headlineLine2}</em>
      </h1>
      <p class="hero__lead" data-cms="hero_lead">{HOME_HERO.lead}</p>

      <div class="hero__actions">
        <EnrolLink
          destination={TEACHABLE_CATALOG_URL}
          partner={partner}
          label={HOME_HERO.primaryCtaLabel}
          class="btn btn--gold"
        />
        <a href={registrationHref} class="btn btn--outline-light">
          {HOME_HERO.secondaryCtaLabel}
        </a>
      </div>

      <p class="hero__note">{HOME_HERO.accountNote}</p>
    </div>
  </div>
</section>

<section class="why-strip" aria-labelledby="why-study-heading">
  <div class="container why-strip__inner">
    <h2 id="why-study-heading" class="why-strip__heading">{HOME_HERO.whyTitle}</h2>
    <ul class="why-strip__list">
      {HOME_HERO.whyPoints.map((point, i) => (
        <li class="why-strip__item">
          <span aria-hidden="true" class="why-strip__icon"><Icon name={whyIcons[i] ?? 'check'} /></span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

{partner && <PartnerIntro partner={partner} />}

<section class="courses-section" aria-labelledby="online-courses-heading">
  <div class="container courses-section__inner">
    <div class="courses-section__header">
      <div class="courses-section__intro">
        <h2 id="online-courses-heading" class="courses-section__heading">
          {HOME_COURSES_INTRO.heading}
        </h2>
        <p class="courses-section__lead" data-cms="courses_lead">{HOME_COURSES_INTRO.lead}</p>
      </div>

      <EnrolLink
        destination={TEACHABLE_CATALOG_URL}
        partner={partner}
        label={HOME_COURSES_INTRO.allCoursesLabel}
        class="btn btn--outline-navy"
      />
    </div>

    <div class="programme-grid">
      {HOME_PROGRAMMES.map((programme) => (
        <article class="programme-card">
          <div class="programme-card__media">
            <img src={`/images/courses/${programme.id}.webp`} alt="" width="800" height="450" loading="lazy" decoding="async" />
          </div>
          <div class="programme-card__top">
            <span class="programme-card__badge" aria-hidden="true">
              <Icon name={programmeIcons[programme.id] ?? 'file'} />
            </span>
            <p class="programme-card__code">{programme.code}</p>
          </div>
          <h3 class="programme-card__title">{programme.title}</h3>
          <p class="programme-card__blurb">{programme.blurb}</p>
          <ul class="programme-card__chips">
            {programme.meta.split(' · ').map((chip) => (
              <li class="programme-card__chip">{chip}</li>
            ))}
          </ul>
          {programme.teachableUrl ? (
            <EnrolLink
              destination={programme.teachableUrl}
              partner={partner}
              label={programme.ctaLabel}
              hint={programme.title}
              class="programme-card__cta"
            />
          ) : (
            <a
              href={pageUrl(programme.internalPage ?? 'contact', partner)}
              class="programme-card__cta"
            >
              {programme.ctaLabel}<span class="sr-only"> — {programme.title}</span>
            </a>
          )}
        </article>
      ))}
    </div>

    <div class="advisor-row">
      <p class="advisor-row__text">
        <strong>Not sure where to start?</strong>
        Tell our student support team about your education and goals, and we will point you to the right course.
      </p>
      <a href={pageUrl('contact', partner)} class="btn btn--outline-navy">Talk to an advisor</a>
    </div>
  </div>
</section>

<HomeSections partner={partner} />

<script is:inline>
  // Background film: never autoplays for reduced-motion users, and can always be paused (WCAG 2.2.2).
  (() => {
    const video = document.querySelector('.hero__video');
    const toggle = document.querySelector('.hero__motion-toggle');
    if (!video || !toggle) return;
    const set = (paused) => {
      paused ? video.pause() : video.play().catch(() => {});
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) set(true);
    toggle.addEventListener('click', () => set(!video.paused));
  })();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(88svh, 820px);
    display: flex;
    align-items: center;
    background: var(--color-navy);
    color: var(--color-white);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Wide screens: the film sits right of the headline and fades in, so copy never covers a face. */
  @media (min-width: 900px) {
    .hero__media {
      left: 26%;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 28%);
    }
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  /* Brand-tinted veil: solid where the copy sits, clear where the film plays. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, var(--color-navy) 0%, color-mix(in srgb, var(--color-navy) 70%, transparent) 42%, color-mix(in srgb, var(--color-navy) 8%, transparent) 72%, transparent 100%),
      linear-gradient(0deg, color-mix(in srgb, var(--color-navy) 70%, transparent) 0%, transparent 35%);
  }

  /* Phones: copy covers the whole film, so the veil is even and deep enough for AA text. */
  @media (max-width: 899px) {
    .hero::before { background: linear-gradient(180deg, color-mix(in srgb, var(--color-navy) 72%, transparent) 0%, color-mix(in srgb, var(--color-navy) 88%, transparent) 100%); }
  }

  /* Film drifts and copy lifts away as the visitor scrolls past (scroll-driven). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__video { animation: hero-drift linear both; animation-timeline: scroll(root); animation-range: 0 100svh; }
      .hero__inner { animation: hero-lift linear both; animation-timeline: scroll(root); animation-range: 0 90svh; }
      /* The pause button leaves with the copy; visibility makes it unfocusable once gone. */
      .hero__motion-toggle { animation: toggle-hide linear both; animation-timeline: scroll(root); animation-range: 0 45svh; }
    }
  }
  @keyframes toggle-hide { to { opacity: 0; visibility: hidden; } }
  @keyframes hero-drift { from { transform: scale(1.04); } to { transform: scale(1.16) translateY(6%); } }
  @keyframes hero-lift { to { transform: translateY(-80px); opacity: 0.2; } }

  .hero__motion-toggle {
    position: absolute;
    right: 24px;
    bottom: 24px;
    z-index: 2;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-white) 35%, transparent);
    background: color-mix(in srgb, var(--color-navy) 40%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .hero__motion-toggle:hover { border-color: var(--color-gold-light); background: color-mix(in srgb, var(--color-navy) 70%, transparent); }
  .hero__icon-play, .hero__motion-toggle[aria-pressed='true'] .hero__icon-pause { display: none; }
  .hero__motion-toggle[aria-pressed='true'] .hero__icon-play { display: block; }

  .hero__inner {
    width: 100%;
    padding-block: 96px 104px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
  }

  .hero__copy {
    flex: 999 1 560px;
    min-width: 0;
  }

  .hero__eyebrow {
    margin: 0 0 20px;
    font-size: 12px;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 500;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5.4vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.012em;
    font-weight: 600;
    color: var(--color-white);
  }

  .hero__title-em {
    font-style: italic;
    font-weight: 500;
    color: var(--color-gold-light);
  }

  .hero__lead {
    margin: 26px 0 0;
    font-size: 18px;
    line-height: 1.62;
    color: var(--color-on-dark);
    max-width: 580px;
  }

  .hero__actions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__note {
    margin: 22px 0 0;
    font-size: 13.5px;
    color: var(--color-on-dark-muted);
  }

  .why-strip {
    background: var(--color-navy-elevated);
    border-bottom: 1px solid var(--color-navy-card-border);
  }

  .why-strip__inner {
    padding-block: 28px;
  }

  .why-strip__heading {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.3;
  }

  .why-strip__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 28px;
  }

  .why-strip__item {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15.5px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-white);
  }

  .why-strip__icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-navy);
    border: 1px solid var(--color-navy-card-border);
    color: var(--color-gold-light);
  }

  .why-strip__icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .courses-section {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .courses-section__inner {
    padding-block: 60px 64px;
  }

  .courses-section__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }

  .courses-section__intro {
    flex: 999 1 460px;
    min-width: 0;
  }

  .courses-section__heading {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--color-navy);
    line-height: 1.2;
  }

  .courses-section__lead {
    margin: 12px 0 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 620px;
  }

  .programme-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .programme-card {
    position: relative;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-gold);
    background: var(--color-cream);
    padding: 26px 26px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .programme-card:hover,
  .programme-card:focus-within {
    border-color: var(--color-gold);
    box-shadow: 0 10px 28px rgba(21, 35, 62, 0.1);
  }

  /* Photo bleeds to the card edges; it drifts inside its frame as the card scrolls past. */
  .programme-card__media {
    margin: -26px -26px 4px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-navy);
  }

  .programme-card__media img {
    width: 100%;
    height: 118%;
    object-fit: cover;
    transform: translateY(-8%);
    transition: scale 600ms var(--ease-out);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .programme-card:hover .programme-card__media img { scale: 1.05; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .programme-card__media img { animation: card-parallax linear both; animation-timeline: view(); animation-range: cover; }
    }
  }
  @keyframes card-parallax { from { transform: translateY(-15%); } to { transform: translateY(0%); } }

  .programme-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .programme-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-gold-light);
    flex-shrink: 0;
  }

  .programme-card__badge :global(svg) {
    width: 24px;
    height: 24px;
  }

  .programme-card__code {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
    font-weight: 700;
  }

  .programme-card__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-navy);
  }

  .programme-card__blurb {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-text-muted);
    flex-grow: 1;
  }

  .programme-card__chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .programme-card__chip {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-navy);
    background: var(--color-sand);
    border: 1px solid var(--color-border);
    padding: 4px 10px;
    border-radius: 999px;
  }

  .programme-card :global(.programme-card__cta) {
    margin: 4px -26px 0;
    padding: 0 26px;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
  }

  .programme-card :global(.programme-card__cta)::after {
    content: '→';
    content: '→' / '';
    font-size: 18px;
    color: var(--color-gold-dark);
    transition: transform 0.2s ease;
  }

  .programme-card :global(.programme-card__cta):hover {
    color: var(--color-gold-dark);
  }

  .programme-card :global(.programme-card__cta):hover::after {
    transform: translateX(4px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .advisor-row {
    margin-top: 32px;
    padding: 22px 26px;
    background: var(--color-sand);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-gold);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }

  .advisor-row__text {
    margin: 0;
    font-size: 16px;
    color: var(--color-text);
    flex: 1 1 360px;
  }

  .advisor-row__text strong {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--color-navy);
    display: block;
    font-size-adjust: 0.44;
  }

  @media (max-width: 960px) {
    .hero__inner {
      padding-block: 56px;
      gap: 36px;
    }

    .programme-grid,
    .why-strip__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* copy covers the photo on narrow screens: flatten the overlay for legibility */
    .hero {
      background:
        linear-gradient(color-mix(in srgb, var(--color-navy) 82%, transparent), color-mix(in srgb, var(--color-navy) 82%, transparent)),
        url('/images/doctors-desk.jpg') 70% center / cover no-repeat,
        var(--color-navy);
    }
  }

  @media (max-width: 620px) {
    .hero__inner {
      padding-block: 44px 48px;
      gap: 28px;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .why-strip__list {
      grid-template-columns: 1fr;
    }

    .courses-section__inner {
      padding-block: 44px 48px;
    }

    .courses-section__header {
      margin-bottom: 28px;
    }

    .programme-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .programme-card {
      padding: 22px 20px 0;
    }

    .programme-card :global(.programme-card__cta) {
      margin-inline: -20px;
      padding-inline: 20px;
    }
  }
</style>
