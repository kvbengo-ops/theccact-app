---
// Partner home: a personal introduction to the partner, inside the same institutional template.
// Only verified record fields are shown; nothing is written in the partner's voice.
import { getPartnerInitials } from '../content/site.mjs';
import { pageUrl } from '../lib/links.mjs';
import Icon from './Icon.astro';

interface Props {
  partner: { slug: string; name: string; type?: string; role?: string; location?: string; bio?: string; image?: string; website?: string; contactName?: string; languages?: string[]; services?: string[] };
}

const { partner } = Astro.props;
const isOrg = partner.type === 'organisation';
const firstPara = String(partner.bio ?? '').split(/\r?\n\s*\r?\n/)[0].trim();
// ponytail: plain character cut at a word boundary; fine for short bios.
const excerpt = firstPara.length > 260 ? `${firstPara.slice(0, 260).replace(/\s+\S*$/, '')}…` : firstPara;
const firstName = isOrg ? partner.name : String(partner.name).trim().split(/\s+/)[0];
---

<section class="partner-intro" aria-labelledby="partner-intro-heading">
  <div class="container partner-intro__inner">
    <div class:list={['partner-intro__portrait', isOrg && 'partner-intro__portrait--org', !partner.image && 'partner-intro__portrait--empty']}>
      {partner.image
        ? <img src={partner.image} alt={`Portrait of ${partner.name}`} width="640" height="800" loading="lazy" decoding="async" />
        : <span aria-hidden="true">{getPartnerInitials(partner.name)}</span>}
    </div>

    <div class="partner-intro__copy">
      <span class="gold-line partner-intro__line" aria-hidden="true"></span>
      <p class="section-eyebrow">{isOrg ? 'Official CCACT affiliate organization' : 'Your CCACT affiliate'}</p>
      <h2 id="partner-intro-heading" class="partner-intro__name">
        <span class="partner-intro__welcome">Welcome. You’re exploring courses with</span>
        {partner.name}
      </h2>
      <p class="partner-intro__relation">
        {firstName} is an authorized CCACT affiliate. Enrollment and tuition payment happen directly with CCACT on Teachable; affiliates never collect tuition.
      </p>

      <dl class="partner-intro__facts">
        {partner.role && <div><dt><Icon name={isOrg ? 'building' : 'user'} />Role</dt><dd>{partner.role}</dd></div>}
        {partner.location && <div><dt><Icon name="pin" />Location</dt><dd>{partner.location}</dd></div>}
        {partner.languages?.length ? <div><dt><Icon name="message" />Languages</dt><dd>{partner.languages.join(', ')}</dd></div> : null}
        {isOrg && partner.contactName && <div><dt><Icon name="user" />Contact</dt><dd>{partner.contactName}</dd></div>}
      </dl>

      {excerpt && <p class="partner-intro__bio">{excerpt}</p>}

      {partner.services?.length ? (
        <div class="partner-intro__support">
          <p class="partner-intro__support-title">How {firstName} can help</p>
          <ul>{partner.services.map((s) => <li>{s}</li>)}</ul>
        </div>
      ) : null}

      <div class="partner-intro__actions">
        <a href={pageUrl('about-partner', partner)} class="btn btn--navy">{isOrg ? 'About this organization' : `Read ${firstName}’s full profile`}</a>
        {isOrg && partner.website?.startsWith('https://')
          ? <a href={partner.website} target="_blank" rel="noopener noreferrer" class="text-link">Visit website<span class="sr-only"> (opens in a new tab)</span></a>
          : <a href={pageUrl('contact', partner)} class="text-link">Contact via CCACT</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }

  .partner-intro { background: var(--color-cream); border-bottom: 1px solid var(--color-border); }

  .partner-intro__inner {
    padding-block: 96px;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 40px 72px;
    align-items: center;
  }

  .partner-intro__portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 6px;
    overflow: clip;
    background: var(--color-navy);
    box-shadow: 18px 18px 0 -1px var(--color-sand), 18px 18px 0 0 var(--color-gold);
  }
  .partner-intro__portrait img { width: 100%; height: 100%; object-fit: cover; }
  .partner-intro__portrait--empty { display: grid; place-items: center; }
  .partner-intro__portrait--empty span { font-family: var(--font-serif); font-size: clamp(4rem, 9vw, 7rem); font-weight: 600; color: var(--color-gold-light); letter-spacing: 0.04em; }
  .partner-intro__portrait--org.partner-intro__portrait--empty { aspect-ratio: 1; }

  .partner-intro__line { width: 64px; margin-bottom: 22px; }

  .partner-intro__name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.6vw, 4rem);
    line-height: 1.02;
    font-weight: 600;
    color: var(--color-navy);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .partner-intro__welcome {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  .partner-intro__relation { margin: 20px 0 0; max-width: 58ch; font-size: 15px; line-height: 1.6; color: var(--color-text-muted); }

  .partner-intro__facts { margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 16px 36px; }
  .partner-intro__facts dt { display: flex; align-items: center; gap: 6px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-gold-dark); }
  .partner-intro__facts dt :global(svg) { width: 14px; height: 14px; }
  .partner-intro__facts dd { margin: 4px 0 0; font-size: 16px; color: var(--color-navy); }

  .partner-intro__bio { margin: 26px 0 0; max-width: 60ch; font-size: 17px; line-height: 1.7; color: var(--color-text); }

  .partner-intro__support { margin-top: 24px; }
  .partner-intro__support-title { margin: 0 0 10px; font-weight: 700; color: var(--color-navy); }
  .partner-intro__support ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .partner-intro__support li { position: relative; padding-left: 26px; color: var(--color-text); }
  .partner-intro__support li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 14px; height: 1px; background: var(--color-gold); }

  .partner-intro__actions { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }

  @media (max-width: 899px) {
    .partner-intro__inner { grid-template-columns: 1fr; padding-block: 64px; }
    .partner-intro__portrait { max-width: 320px; }
  }
</style>
