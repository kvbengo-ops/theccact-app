---
// Homepage sections after the course explorer. Content comes from the existing page data, so it stays in sync.
import { pageUrl } from '../lib/links.mjs';
import { TEACHABLE_CATALOG_URL } from '../content/site.mjs';
import { ABOUT_PAGE, COURSES_PAGE, FAQ_PAGE, REGISTRATION_PAGE, STUDY_IN_CANADA_PAGE } from '../content/pages.mjs';
import EnrolLink from './EnrolLink.astro';
import Icon from './Icon.astro';

interface Props {
  partner?: { slug: string; name: string; referralCode?: string } | null;
}

const { partner = null } = Astro.props;
const steps = REGISTRATION_PAGE.steps;
const faqs = FAQ_PAGE.sections.flatMap((section) => section.items).slice(0, 5);
const sic = STUDY_IN_CANADA_PAGE;
const cta = COURSES_PAGE.bottomCta;
const people = ABOUT_PAGE.directorsSection;
const message = ABOUT_PAGE.collegeMessage;
---

<!-- Human credibility: the real directors and the college's own message (no invented testimonials) -->
<section class="people" aria-labelledby="people-heading">
  <div class="container people__inner">
    <div class="people__intro">
      <p class="section-eyebrow">The people behind the college</p>
      <h2 id="people-heading" class="people__heading">{people.heading}</h2>
      <blockquote class="people__quote">
        <p>{message.paragraphs[0]}</p>
        <footer>{message.signoff}</footer>
      </blockquote>
      <div class="people__links">
        <a href={pageUrl('about', partner)} class="text-link">Read our story</a>
        <a href={pageUrl('study-in-canada', partner)} class="text-link">{sic.hero.title}: meet Jean</a>
      </div>
    </div>
    <ul class="people__grid">
      {people.members.map((m) => (
        <li class="person">
          <div class="person__photo">
            <img src={m.photo} alt={`Portrait of ${m.name}`} width={m.width} height={m.height} loading="lazy" decoding="async" />
          </div>
          <p class="person__name">{m.name}</p>
          <p class="person__role">{m.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- How enrollment works -->
<section class="enrol" aria-labelledby="enrol-heading" data-enrol>
  <div class="container enrol__inner">
    <div class="enrol__head">
      <p class="section-eyebrow">Getting started</p>
      <h2 id="enrol-heading" class="section-heading">{REGISTRATION_PAGE.stepsHeading}</h2>
      <p class="section-lead">{REGISTRATION_PAGE.stepsLead}</p>
    </div>
    <div class="enrol__media">
      {/* Brand film: CCES builds swap /media/enrol-ccact for /media/enrol-cces (CCES_REWRITES).
          It plays by itself once the section is in view, and steps 1–4 light up as it plays. */}
      <video
        class="enrol__film"
        src="/media/enrol-ccact.mp4"
        poster="/media/enrol-ccact.webp"
        width="1280"
        height="720"
        muted
        playsinline
        preload="none"
        aria-hidden="true"
      ></video>
      <p class="enrol__open"><Icon name="clock" />{REGISTRATION_PAGE.openCard.title}</p>
    </div>
    <div class="enrol__body">
      <div class="enrol__path" data-enrol-path>
        <span class="enrol__dot" aria-hidden="true"></span>
        <ol class="enrol__steps">
          {steps.map((step) => (
            <li data-enrol-step>
              <span class="enrol__num" aria-hidden="true">{step.num}</span>
              <div class="enrol__step-text">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <p class="enrol__note">{REGISTRATION_PAGE.openCard.note}</p>
      <div class="enrol__actions">
        <EnrolLink destination={TEACHABLE_CATALOG_URL} partner={partner} label="Start on Teachable" class="btn btn--gold" />
        <a href={pageUrl('registration', partner)} class="btn btn--outline-navy">Registration details</a>
      </div>
    </div>
  </div>
</section>

<!-- FAQ teaser -->
<section class="faq" aria-labelledby="faq-heading">
  <div class="container faq__inner">
    <div>
      <p class="section-eyebrow">{FAQ_PAGE.hero.eyebrow}</p>
      <h2 id="faq-heading" class="section-heading">Common questions</h2>
      <p class="section-lead">Quick answers about how CCACT courses work.</p>
      <a href={pageUrl('faq', partner)} class="faq__all">See all questions <Icon name="arrow" /></a>
    </div>
    <div class="faq__list">
      {faqs.map((item) => (
        <details class="faq__item">
          <summary>{item.q}<Icon name="chevron" class="faq__chev" /></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- Closing invitation -->
<section class="final" aria-labelledby="final-heading">
  <div class="final__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 760px)" srcset="/images/closing-800.webp" />
      <img src="/images/closing-1920.webp" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    </picture>
  </div>
  <div class="container final__inner">
    <span class="gold-line final__line" aria-hidden="true"></span>
    <h2 id="final-heading" class="final__title">Begin your<br /><em>next chapter.</em></h2>
    <p class="final__lead">{cta.lead}</p>
    <div class="final__actions">
      <EnrolLink destination={TEACHABLE_CATALOG_URL} partner={partner} label="Explore courses" class="btn btn--gold" />
      <a href={pageUrl('contact', partner)} class="btn btn--outline-light">{cta.secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  /* How enrollment works */
  .enrol {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
  }

  /* Heading across the top; below it the film (wider column) stretches to the height of the steps beside it,
     so there is no empty space and the frame stays wide enough to keep the whole greeting in view. */
  .enrol__inner {
    padding-block: 72px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 6fr);
    gap: 36px 64px;
    align-items: stretch;
  }

  .enrol__head {
    grid-column: 1 / -1;
    max-width: 720px;
  }

  .enrol__head .section-lead {
    margin-bottom: 0;
  }

  .enrol__body {
    align-self: center;
  }

  .enrol__body .enrol__path {
    margin-top: 0;
  }

  .enrol__media {
    position: relative;
    display: flex;
  }

  .enrol__film {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 380px;
    object-fit: cover;
    /* The walk ends with a colleague greeting her on the right; keep both in the tall crop. */
    object-position: 62% center;
    border-radius: 8px;
    box-shadow: 0 20px 44px rgba(21, 35, 62, 0.16);
  }

  .enrol__open {
    position: absolute;
    left: 20px;
    bottom: -18px;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: var(--color-navy);
    color: var(--color-gold-light);
    border-radius: 6px;
    font-size: 15px;
    font-weight: 700;
    box-shadow: 0 12px 24px rgba(21, 35, 62, 0.25);
  }

  .enrol__open :global(svg) {
    width: 18px;
    height: 18px;
  }

  .enrol__steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 18px;
  }

  .enrol__steps li {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  .enrol__num {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-white);
    border: 1px solid var(--color-divider);
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-navy);
    font-size-adjust: 0.44;
  }

  .enrol__steps h3 {
    margin: 2px 0 2px;
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-navy);
  }

  .enrol__steps p {
    margin: 0;
    font-size: 15.5px;
    color: var(--color-text-muted);
  }

  .enrol__note {
    margin: 22px 0 0;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .enrol__actions {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* FAQ teaser */
  .faq {
    background: var(--color-sand);
    border-bottom: 1px solid var(--color-border);
  }

  .faq__inner {
    padding-block: 72px;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 56px;
    align-items: start;
  }

  .faq__all {
    margin-top: 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
    color: var(--color-navy);
  }

  .faq__all :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  .faq__all:hover :global(svg) {
    transform: translateX(4px);
  }

  .faq__list {
    display: grid;
    gap: 12px;
  }

  .faq__item {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .faq__item[open] {
    border-color: var(--color-gold);
  }

  .faq__item summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding: 14px 20px;
    cursor: pointer;
    font-size: 16.5px;
    font-weight: 700;
    color: var(--color-navy);
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item :global(.faq__chev) {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--color-gold-dark);
    transition: transform 0.2s ease;
  }

  .faq__item[open] :global(.faq__chev) {
    transform: rotate(180deg);
  }

  .faq__item p {
    margin: 0;
    padding: 0 20px 18px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--color-text);
  }

  /* People */
  .people { background: var(--color-cream); border-top: 1px solid var(--color-border); }
  .people__inner {
    padding-block: 112px;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px 72px;
    align-items: start;
  }
  .people__intro { position: sticky; top: calc(var(--header-h, 72px) + 32px); }
  .people__heading { margin: 0; font-family: var(--font-serif); font-size: clamp(2.4rem, 4.6vw, 4rem); line-height: 1; font-weight: 600; color: var(--color-navy); }
  .people__quote { margin: 36px 0 0; padding-left: 24px; border-left: 1px solid var(--color-gold); }
  .people__quote p { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: clamp(1.3rem, 1.9vw, 1.65rem); line-height: 1.4; color: var(--color-navy); }
  .people__quote footer { margin-top: 14px; font-size: 14px; color: var(--color-text-muted); }
  .people__links { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .people__grid { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 28px; }
  .people__grid .person:nth-child(even) { margin-top: 64px; }
  .person__photo { overflow: clip; border-radius: 6px; aspect-ratio: 574 / 646; background: var(--color-sand); }
  .person__photo img { width: 100%; height: 100%; object-fit: cover; transition: scale 700ms var(--ease-out); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .person:hover .person__photo img { scale: 1.04; } }
  .person__name { margin: 16px 0 2px; font-family: var(--font-serif); font-size: 22px; font-weight: 600; color: var(--color-navy); }
  .person__role { margin: 0; font-size: 14px; line-height: 1.5; color: var(--color-text-muted); }
  @media (max-width: 899px) {
    .people__inner { grid-template-columns: 1fr; padding-block: 80px; }
    .people__intro { position: static; }
    .people__grid .person:nth-child(even) { margin-top: 32px; }
  }

  /* Closing invitation: oversized type over a quiet navy-and-gold field that drifts very slowly. */
  .final {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--color-navy);
    color: var(--color-white);
  }
  .final__media { position: absolute; inset: 0; z-index: -1; }
  .final__media img { width: 100%; height: 100%; object-fit: cover; object-position: 70% center; }
  @media (prefers-reduced-motion: no-preference) {
    .final__media img { animation: ambient 26s ease-in-out infinite alternate; }
  }
  @keyframes ambient { to { transform: scale(1.07) translateX(-1.5%); } }
  .final__inner { padding-block: 150px 140px; }
  .final__line { width: 72px; margin-bottom: 36px; }
  .final__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(3.2rem, 9vw, 8.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--color-white);
  }
  .final__title em { font-weight: 500; color: var(--color-gold-light); }
  .final__lead { margin: 32px 0 0; max-width: 52ch; font-size: 17.5px; color: var(--color-on-dark); }
  .final__actions { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 14px; }
  @media (max-width: 760px) { .final__inner { padding-block: 104px 96px; } }

  /* FAQ: answers ease open where the browser supports animating to auto height. */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .faq__item { interpolate-size: allow-keywords; }
      .faq__item::details-content { block-size: 0; overflow: clip; transition: block-size 320ms var(--ease-out), content-visibility 320ms allow-discrete; }
      .faq__item[open]::details-content { block-size: auto; }
    }
  }

  /* Step path: a faint track from circle 1 to circle 4, a gold fill and a glowing dot that travel down it.
     --y0/--y1 (first/last circle centres) are measured in script; the fallbacks fit the default layout. */
  .enrol__path { position: relative; isolation: isolate; margin-top: 28px; --y0: 22px; --y1: calc(100% - 44px); }
  .enrol__path::before,
  .enrol__path::after {
    content: '';
    position: absolute;
    z-index: -1; /* behind the circles even when a list item carries a transform */
    left: 21px;
    top: var(--y0);
    width: 2px;
    border-radius: 2px;
  }
  .enrol__path::before { height: calc(var(--y1) - var(--y0)); background: var(--color-divider); }
  .enrol__path::after {
    height: calc((var(--y1) - var(--y0)) * var(--line, 1));
    background: linear-gradient(180deg, var(--color-gold-light), var(--color-gold));
    transform-origin: top;
  }
  .enrol__dot {
    position: absolute;
    left: 22px;
    top: calc(var(--y0) + (var(--y1) - var(--y0)) * var(--line, 1));
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--color-gold-light);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-gold) 28%, transparent), 0 0 22px 4px color-mix(in srgb, var(--color-gold) 55%, transparent);
    opacity: 0;
    pointer-events: none;
    z-index: -1;
  }
  .enrol__num { position: relative; z-index: 1; }

  /* Playing mode (motion allowed): the film plays by itself and the dot travels the path in time with it.
     Steps behind the dot stay lit, the current one rings gold, the rest wait faded. Without motion, all steps show. */
  .enrol.is-animated .enrol__dot { opacity: 1; }
  /* Fade the words, never the circles: a see-through circle would show the track running behind it. */
  .enrol.is-animated .enrol__step-text { opacity: 0.32; transform: translateX(12px); transition: opacity 0.5s ease, transform 0.6s var(--ease-out, ease); }
  .enrol.is-animated .enrol__steps li.is-active .enrol__step-text { opacity: 0.72; transform: none; }
  .enrol.is-animated .enrol__steps li.is-current .enrol__step-text { opacity: 1; }
  .enrol.is-animated .enrol__num { color: var(--color-text-muted); transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease, box-shadow 0.5s ease, transform 0.5s var(--ease-out, ease); }
  .enrol.is-animated li.is-active .enrol__num { background: var(--color-navy); color: var(--color-gold-light); border-color: var(--color-gold); }
  .enrol.is-animated li.is-current .enrol__num { transform: scale(1.1); box-shadow: 0 0 0 7px color-mix(in srgb, var(--color-gold) 22%, transparent); }

  @media (max-width: 960px) {
    .enrol__inner,
    .faq__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .enrol__film {
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 620px) {
    .enrol__inner,
    .faq__inner {
      padding-block: 52px;
    }

    .enrol__actions .btn,
    .final__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  // How enrollment works: the film plays by itself once the section is in view, and the gold dot walks steps 1–4
  // in time with it. Scrolling never drives the film, so there is nothing for fast or reverse scrolling to break.
  const enrol = document.querySelector<HTMLElement>('[data-enrol]');
  const film = enrol?.querySelector<HTMLVideoElement>('video.enrol__film');
  if (enrol && film && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const path = enrol.querySelector<HTMLElement>('[data-enrol-path]')!;
    const steps = Array.from(enrol.querySelectorAll<HTMLElement>('[data-enrol-step]'));
    const nums = steps.map((step) => step.querySelector<HTMLElement>('.enrol__num')!);

    // The track runs from the centre of circle 1 to the centre of circle 4; each circle's place along it (0–1) is where it lights.
    let stops: number[] = [];
    const measure = () => {
      const top = path.getBoundingClientRect().top;
      const centres = nums.map((n) => { const r = n.getBoundingClientRect(); return r.top + r.height / 2 - top; });
      const y0 = centres[0], y1 = centres[centres.length - 1];
      path.style.setProperty('--y0', `${y0}px`);
      path.style.setProperty('--y1', `${y1}px`);
      stops = centres.map((c) => (c - y0) / (y1 - y0 || 1));
    };

    const draw = (p: number) => {
      // The dot reaches circle 4 at 85% of the film, leaving the last moments on the final step.
      const line = Math.min(1, p / 0.85);
      path.style.setProperty('--line', line.toFixed(4));
      let current = 0;
      steps.forEach((step, i) => { const on = line >= stops[i] - 0.015; step.classList.toggle('is-active', on); if (on) current = i; });
      steps.forEach((step, i) => step.classList.toggle('is-current', i === current));
    };
    const sync = () => { if (film.duration) draw(film.ended ? 1 : film.currentTime / film.duration); };

    enrol.classList.add('is-animated');
    measure();
    draw(0);
    addEventListener('resize', () => { measure(); sync(); });

    // Follow the film every frame while it plays; hold still when it pauses or ends.
    let raf = 0;
    const follow = () => { sync(); raf = film.paused || film.ended ? 0 : requestAnimationFrame(follow); };
    film.addEventListener('play', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(follow); });
    film.addEventListener('pause', sync);
    film.addEventListener('ended', sync);

    // Start downloading shortly before the section arrives, so it plays the moment it is on screen.
    const soon = new IntersectionObserver(([entry]) => { if (entry.isIntersecting) { film.preload = 'auto'; soon.disconnect(); } }, { rootMargin: '100% 0px' });
    soon.observe(film);

    // Play once when at least half the film is on screen and hold on the last frame (step 4 lit).
    // Leaving pauses it; coming back resumes, or replays from the start if it had finished.
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        if (film.ended) film.currentTime = 0;
        film.play().catch(() => {});
      } else {
        film.pause();
      }
    }, { threshold: 0.5 }).observe(film);
  }
  // Reduced motion: the poster stays still and all four steps show as written.
</script>
