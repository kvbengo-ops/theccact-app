---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero" aria-labelledby="page-hero-heading">
  <div class="container page-hero__inner">
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1 id="page-hero-heading" class="page-hero__title">{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(120deg, var(--color-navy) 0%, var(--color-navy) 55%, var(--color-navy-elevated) 100%);
    color: var(--color-white);
    border-bottom: 3px solid var(--color-gold);
  }

  /* Quiet concentric rings on the right: depth without imagery. */
  .page-hero::after {
    content: '';
    position: absolute;
    right: -120px;
    top: 50%;
    width: 420px;
    height: 420px;
    transform: translateY(-50%);
    border-radius: 50%;
    border: 1px solid var(--color-navy-card-border);
    box-shadow: 0 0 0 40px transparent, 0 0 0 41px var(--color-navy-card-border), 0 0 0 80px transparent, 0 0 0 81px var(--color-navy-border);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
  }

  .page-hero__inner {
    padding-block: 64px 60px;
  }

  .page-hero__eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 500;
  }

  .page-hero__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.2vw, 3rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-white);
    max-width: 780px;
  }

  .page-hero__lead {
    margin: 18px 0 0;
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--color-on-dark);
    max-width: 660px;
  }

  :global(.page-hero__actions) {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  @media (max-width: 640px) {
    .page-hero__inner {
      padding-block: 44px 40px;
    }
  }
</style>
