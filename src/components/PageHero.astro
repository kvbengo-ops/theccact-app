---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero" aria-labelledby="page-hero-heading">
  <div class="container page-hero__inner">
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1 id="page-hero-heading" class="page-hero__title">{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    background: var(--color-navy);
    color: var(--color-white);
    border-bottom: 1px solid var(--color-navy-border);
  }

  .page-hero__inner {
    padding-block: 60px 56px;
  }

  .page-hero__eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 500;
  }

  .page-hero__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.2vw, 3rem);
    line-height: 1.12;
    font-weight: 600;
    color: var(--color-white);
    max-width: 780px;
  }

  .page-hero__lead {
    margin: 18px 0 0;
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--color-on-dark);
    max-width: 660px;
  }

  :global(.page-hero__actions) {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  @media (max-width: 640px) {
    .page-hero__inner {
      padding-block: 44px 40px;
    }
  }
</style>
