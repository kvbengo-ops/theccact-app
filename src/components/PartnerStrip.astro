---
import { BRAND, getPartnerInitials } from '../content/site.mjs';
import { pageUrl } from '../lib/links.mjs';
import Icon from './Icon.astro';

interface Props {
  partner: {
    slug: string;
    name: string;
    type?: string;
    image?: string;
  };
}

const { partner } = Astro.props;
const initials = getPartnerInitials(partner.name);
const isOrg = partner.type === 'organisation';
const profileHref = pageUrl('about-partner', partner);
---

<aside class="partner-strip" aria-label="Authorised partner information">
  <div class="container partner-strip__inner">
    <a href={profileHref} class="partner-strip__identity">
      <span class:list={['partner-strip__avatar', isOrg && 'partner-strip__avatar--org']} aria-hidden="true">
        {partner.image ? <img src={partner.image} alt="" width="40" height="40" loading="eager" decoding="async" /> : initials}
      </span>
      <span class="partner-strip__text">
        <span class="partner-strip__label">Your CCACT partner</span>
        <strong class="partner-strip__name">{partner.name}</strong>
      </span>
    </a>

    <span class="partner-strip__badge">
      <Icon name="shield" />
      Authorised partner
    </span>

    <nav class="partner-strip__links" aria-label="Partner">
      <a href={profileHref}>View profile</a>
      <a href={BRAND.mainDirectoryHref}>Verify this partner</a>
    </nav>
  </div>
</aside>

<style>
  .partner-strip {
    background: var(--color-sand);
    border-bottom: 1px solid var(--color-border);
  }

  .partner-strip__inner {
    padding-block: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
  }

  .partner-strip__identity {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    min-height: 44px;
    text-decoration: none;
  }

  .partner-strip__avatar {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    display: inline-grid;
    place-items: center;
    background: var(--color-navy);
    color: var(--color-gold-light);
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--color-white), 0 0 0 3px var(--color-divider);
  }

  .partner-strip__avatar--org {
    border-radius: 8px;
  }

  .partner-strip__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .partner-strip__text {
    display: grid;
    line-height: 1.25;
    min-width: 0;
  }

  .partner-strip__label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-badge);
  }

  .partner-strip__name {
    font-size: 15.5px;
    color: var(--color-navy);
    overflow-wrap: anywhere;
  }

  .partner-strip__identity:hover .partner-strip__name {
    color: var(--color-gold-dark);
  }

  .partner-strip__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 8px;
    border: 1px solid var(--color-divider);
    border-radius: 999px;
    background: var(--color-white);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-gold-badge);
  }

  .partner-strip__badge :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--color-gold-dark);
  }

  .partner-strip__links {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .partner-strip__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .partner-strip__links a:hover {
    color: var(--color-gold-dark);
  }

  @media (max-width: 720px) {
    .partner-strip__links {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
