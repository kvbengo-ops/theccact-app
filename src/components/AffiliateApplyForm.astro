---
// One component, two forms: individual and organization applications ask for different details.
import Icon from './Icon.astro';
import { AFFILIATE_FORMS } from '../content/affiliate-forms.mjs';

interface Props {
  type: 'individual' | 'organisation';
}

const { type } = Astro.props;
const isOrg = type === 'organisation';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const copy = isOrg
  ? {
      kicker: 'Organization application',
      heading: 'Apply as an organization',
      intro: 'For immigration consultancies, education agencies, nursing schools and healthcare recruiters.',
      gets: ['A dedicated CCACT site for your organization', 'Your logo, description and location', 'A link to your website', 'Teachable referral links'],
    }
  : {
      kicker: 'Individual application',
      heading: 'Apply as an individual',
      intro: 'For internationally educated nurses, graduates, educators and community connectors.',
      gets: ['Your own authorized CCACT affiliate site', 'Your reviewed bio and optional portrait', 'A listing in the affiliate directory, if you choose', 'Personal Teachable referral links'],
    };
const sections = AFFILIATE_FORMS[type];
const AUTOCOMPLETE = { fullLegalName: 'name', contactName: 'name', companyName: 'organization', email: 'email', phone: 'tel', mobilePhone: 'tel', city: 'address-level2', province: 'address-level1', country: 'country-name', postalCode: 'postal-code', businessAddress: 'street-address' };
const otherHref = isOrg ? '/affiliate-apply/individual/' : '/affiliate-apply/organisation/';
---

<section class="band band--sand">
  <div class="container application-layout">
    <div class="application-intro">
      <span class:list={['type-badge', isOrg ? 'type-badge--org' : 'type-badge--ind']} aria-hidden="true">
        <Icon name={isOrg ? 'building' : 'user'} />
      </span>
      <p class="eyebrow">{copy.kicker}</p>
      <h2>{copy.heading}</h2>
      <p>{copy.intro}</p>
      <p class="gets-title">What you get</p>
      <ul class="gets">
        {copy.gets.map((item) => <li><Icon name="check" />{item}</li>)}
      </ul>
      <ol class="steps">
        <li><span>01</span><div><strong>{isOrg ? 'Tell us about your organization' : 'Tell us about yourself'}</strong><p>Share your details with CCACT.</p></div></li>
        <li><span>02</span><div><strong>Create your password</strong><p>Your email from the form becomes your login. Then your application is sent.</p></div></li>
        <li><span>03</span><div><strong>Await review</strong><p>CCACT reviews every application before anything is published.</p></div></li>
      </ol>
      <p class="switch">{isOrg ? 'Applying for yourself?' : 'Applying for an organization?'} <a href={otherHref}>{isOrg ? 'Use the individual form' : 'Use the organization form'}</a></p>
      <a class="back-link" href="/affiliates/">← Back to affiliate information</a>
    </div>

    <div class="application-card" data-affiliate-application data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}>
      <p class="eyebrow">Your application</p>
      <h2>{isOrg ? 'Business affiliate application' : 'Individual affiliate application'}</h2>
      <p class="card-intro">Your account stays pending until CCACT reviews your application.</p>
      <p id="affiliate-status" role="status" aria-live="polite">Step 1 of 2: complete the application.</p>
      {supabaseUrl && supabaseKey && <>
        <form id="affiliate-application">
          <input type="hidden" name="type" value={type} />
          <fieldset id="details-step">
            <legend>Step 1 of 2 · Application</legend>
            {sections.map((section, i) => (
              <section class="q-section" aria-labelledby={`q-${i + 1}`}>
                <h3 id={`q-${i + 1}`}><span>{i + 1}</span>{section.title}</h3>
                {section.items.map((item) => {
                  if ('p' in item) return <p class="q-note">{item.p}</p>;
                  if ('h' in item) return <h4>{item.h}</h4>;
                  if ('li' in item) return <ul class="q-list">{item.li.map((li) => <li>{li}</li>)}</ul>;
                  if ('check' in item) return <label class="choice"><input type="checkbox" name="ageConfirm" value="Yes" required />{item.check}</label>;
                  if ('group' in item) return (
                    <div class="choices" role="group">
                      {item.options.map((option) => (
                        <label class="choice"><input type={item.type} name={item.group} value={option} required={item.required} />{option}</label>
                      ))}
                    </div>
                  );
                  const props = { name: item.field, required: item.required, placeholder: item.placeholder, autocomplete: AUTOCOMPLETE[item.field] };
                  return (
                    <label>{item.label}{item.required && ' *'}
                      {item.type === 'textarea'
                        ? <textarea {...props} maxlength="2000" rows="4"></textarea>
                        : <input {...props} type={item.field === 'declarationDate' ? 'date' : item.type} maxlength="300" />}
                    </label>
                  );
                })}
              </section>
            ))}
            <button class="btn btn--gold" type="button" id="application-next">Continue</button>
          </fieldset>
          <fieldset id="account-step" hidden>
            <legend>Step 2 of 2 · Your password</legend>
            <label>Password <input name="password" type="password" autocomplete="new-password" minlength="8" aria-describedby="password-hint" required /><small id="password-hint">Use at least 8 characters.</small></label>
            <div class="actions"><button class="btn btn--outline-navy" type="button" id="application-back">Back</button><button class="btn btn--gold" type="submit">Create account and apply</button></div>
          </fieldset>
        </form>
        <p id="affiliate-login-link">Already have an account? <a href="/affiliate/login/">Sign in</a>.</p>
        <button id="affiliate-logout" class="btn btn--outline-navy" type="button" hidden>Sign out</button>
      </>}
      <noscript>JavaScript is required to create an account and submit an application.</noscript>
    </div>
  </div>
</section>

<script>import '../scripts/affiliate-apply.mjs';</script>
<style>
  .application-layout { display: grid; gap: 48px; }
  .application-card { max-width: 880px; }
  .application-intro { max-width: 720px; }
  .type-badge { display: inline-grid; place-items: center; width: 64px; height: 64px; margin-bottom: 18px; background: var(--color-navy); color: var(--color-gold-light); }
  .type-badge--ind { border-radius: 50%; }
  .type-badge--org { border-radius: 14px; }
  .type-badge :global(svg) { width: 30px; height: 30px; }
  .eyebrow { margin: 0 0 12px; color: var(--color-gold-dark); font-size: 12.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--color-navy); font-family: var(--font-serif); font-size: clamp(1.9rem, 3vw, 2.5rem); line-height: 1.15; }
  .application-intro > p:not(.eyebrow):not(.gets-title) { color: var(--color-text-muted); line-height: 1.7; }
  .gets-title { margin: 24px 0 10px; font-size: 12.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--color-navy); }
  .gets { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .gets li { display: flex; gap: 10px; align-items: flex-start; font-size: 15.5px; color: var(--color-text); }
  .gets :global(svg) { width: 18px; height: 18px; margin-top: 3px; flex-shrink: 0; color: var(--color-gold-dark); stroke-width: 2.25; }
  .steps { list-style: none; padding: 0; margin: 32px 0; display: grid; gap: 24px; }
  .steps li { display: flex; gap: 16px; }
  .steps span { color: var(--color-gold-dark); font-family: var(--font-serif); font-size: 23px; line-height: 1.2; }
  .steps strong { color: var(--color-navy); }
  .steps p { margin: 4px 0 0; color: var(--color-text-muted); font-size: 14.5px; }
  .switch { font-size: 15px; }
  .switch a { font-weight: 700; }
  .back-link { font-weight: 700; }
  .application-card { background: var(--color-white); border: 1px solid var(--color-border); border-top: 4px solid var(--color-gold); padding: clamp(24px, 4vw, 40px); box-shadow: 0 12px 35px rgb(21 35 62 / 7%); }
  .application-card h2 { font-size: 1.9rem; }
  .card-intro { color: var(--color-text-muted); font-size: 15px; }
  #affiliate-status { padding: 12px 14px; background: var(--color-cream); border-left: 3px solid var(--color-gold); color: var(--color-navy); font-size: 14.5px; }
  form { display: grid; gap: 18px; margin: 24px 0; }
  form[hidden] { display: none; }
  label { display: grid; gap: 7px; color: var(--color-navy); font-size: 14.5px; font-weight: 700; }
  label small { color: var(--color-text-muted); font-weight: 400; font-size: 13.5px; }
  fieldset { display: grid; gap: 18px; padding: 0; border: 0; min-width: 0; }
  fieldset[hidden] { display: none; }
  legend { margin-bottom: 18px; color: var(--color-navy); font-weight: 700; }
  input, select, textarea { width: 100%; min-height: 48px; padding: 12px; border: 1px solid var(--color-navy-outline); border-radius: var(--radius-sm); background: var(--color-white); color: var(--color-navy); font: inherit; font-size: 16px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  button[hidden], [hidden] { display: none; }
  .q-section { display: grid; gap: 16px; padding-top: 28px; border-top: 1px solid var(--color-border); }
  .q-section h3 { display: flex; align-items: center; gap: 12px; margin: 0; color: var(--color-navy); font-family: var(--font-serif); font-size: 1.45rem; }
  .q-section h3 span { display: grid; place-items: center; flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; background: var(--color-navy); color: var(--color-gold-light); font-family: var(--font-sans, inherit); font-size: 15px; }
  .q-section h4 { margin: 8px 0 0; color: var(--color-navy); }
  .q-note { margin: 0; color: var(--color-text-muted); font-size: 15px; line-height: 1.65; }
  .q-list { margin: 0; padding-left: 20px; display: grid; gap: 6px; color: var(--color-text-muted); font-size: 15px; }
  .choices { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px 20px; }
  label.choice { display: flex; align-items: flex-start; gap: 10px; font-weight: 400; color: var(--color-text); font-size: 15px; line-height: 1.5; }
  label.choice input { width: 20px; min-height: 20px; height: 20px; margin: 2px 0 0; padding: 0; flex-shrink: 0; accent-color: var(--color-navy); }
  @media (max-width: 760px) { .application-layout { gap: 36px; } }
</style>
