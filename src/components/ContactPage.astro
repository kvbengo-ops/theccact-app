---
import { CONTACT_PAGE } from '../content/pages.mjs';
import { BRAND } from '../content/site.mjs';
import { pageUrl } from '../lib/links.mjs';
import PageHero from './PageHero.astro';

interface Props {
  partner?: { slug: string; name: string } | null;
  formAction?: string;
}

const { partner = null, formAction = '' } = Astro.props;
const faqHref = pageUrl('faq', partner);
const backendReady = Boolean(formAction);
---

<PageHero
  eyebrow={CONTACT_PAGE.hero.eyebrow}
  title={CONTACT_PAGE.hero.title}
  lead={CONTACT_PAGE.hero.lead}
>
  <p class="hero-faq-note">
    Looking for a quick answer? Check our <a href={faqHref} class="hero-faq-link">Frequently Asked Questions</a> first.
  </p>
</PageHero>

<section class="band band--white" aria-labelledby="contact-touch-heading">
  <div class="container contact-grid">
    <div>
      <h2 id="contact-touch-heading" class="section-heading">Get in Touch</h2>
      <p class="section-lead contact-intro">{CONTACT_PAGE.introText}</p>

      <div class="contact-details">
        <div class="editorial-card editorial-card--cream contact-detail-card">
          <h3 class="detail-heading">Email</h3>
          <p class="detail-text">
            <a href={`mailto:${BRAND.contactEmail}`} class="detail-link">
              {BRAND.contactEmail}
            </a>
          </p>
        </div>

        <div class="editorial-card editorial-card--cream contact-detail-card">
          <h3 class="detail-heading">WhatsApp / Text</h3>
          <p class="detail-text">{BRAND.contactPhone}</p>
        </div>

        <div class="editorial-card editorial-card--cream contact-detail-card">
          <h3 class="detail-heading">Office Hours</h3>
          <p class="detail-text">{CONTACT_PAGE.officeHours}</p>
        </div>
      </div>

      <div class="editorial-card editorial-card--cream newsletter-card">
        <h3 class="detail-heading">Stay Connected</h3>
        <p class="newsletter-lead">
          Subscribe to receive updates about new courses, English language modules, and enrolment openings.
        </p>

        <form
          id="newsletter-form"
          class="newsletter-form"
          method="post"
          action={backendReady ? formAction : undefined}
          data-partner-attributed={partner ? 'true' : 'false'}
        >
          <input type="hidden" name="formType" value="newsletter" />
          {partner && (
            <>
              <input type="hidden" name="partnerSlug" value={partner.slug} />
              <input type="hidden" name="partnerName" value={partner.name} />
            </>
          )}
          <div class="form-field">
            <label for="newsletter-email" class="field-label">Email address</label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="Enter your email address"
              class="field-control"
            />
          </div>
          {backendReady ? (
            <button type="submit" class="btn btn--gold">Sign Up</button>
          ) : (
            <div class="callout-box pending-notice">
              Mailing-list submission integration is pending backend configuration (T06). Email{' '}
              <a href={`mailto:${BRAND.contactEmail}`}>{BRAND.contactEmail}</a> to request updates.
            </div>
          )}
        </form>
      </div>
    </div>

    <div class="editorial-card form-panel">
      <h3 class="form-panel__title">Send Us a Message</h3>
      <p class="form-panel__lead">
        Complete the form fields below or contact us directly by email.
      </p>
      {partner && (
        <div class="callout-box attribution-note">
          Your enquiry includes attribution for authorised CCACT partner{' '}
          <strong>{partner.name}</strong>.
        </div>
      )}

      <form
        id="contact-form"
        class="enquiry-form"
        method="post"
        action={backendReady ? formAction : undefined}
        data-partner-attributed={partner ? 'true' : 'false'}
      >
        <input type="hidden" name="formType" value="contact" />
        {partner && (
          <>
            <input type="hidden" name="partnerSlug" value={partner.slug} />
            <input type="hidden" name="partnerName" value={partner.name} />
          </>
        )}

        <div class="form-row">
          <div class="form-field">
            <label for="contact-fname" class="field-label">First Name</label>
            <input
              id="contact-fname"
              name="firstName"
              type="text"
              required
              autocomplete="given-name"
              class="field-control"
            />
          </div>
          <div class="form-field">
            <label for="contact-lname" class="field-label">Last Name</label>
            <input
              id="contact-lname"
              name="lastName"
              type="text"
              required
              autocomplete="family-name"
              class="field-control"
            />
          </div>
        </div>

        <div class="form-field">
          <label for="contact-email" class="field-label">Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="field-control"
          />
        </div>

        <div class="form-field">
          <label for="contact-phone" class="field-label">Phone (optional)</label>
          <input
            id="contact-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            class="field-control"
          />
        </div>

        <div class="form-field">
          <label for="contact-message" class="field-label">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="field-control"
          ></textarea>
        </div>

        {backendReady ? (
          <button type="submit" class="btn btn--gold form-submit">Send Message</button>
        ) : (
          <div class="callout-box pending-notice" role="status">
            Online form delivery service is pending confirmation and spam-protected backend wiring (T06). Please email{' '}
            <a href={`mailto:${BRAND.contactEmail}`}>{BRAND.contactEmail}</a> directly with your enquiry.
          </div>
        )}
      </form>
    </div>
  </div>
</section>

<section class="band band--sand" aria-labelledby="resources-heading">
  <div class="container">
    <h2 id="resources-heading" class="section-heading resources-title">Helpful Resources</h2>
    <div class="editorial-grid-4">
      {CONTACT_PAGE.resources.map((resource) => (
        <article class="editorial-card resource-card">
          <h3 class="resource-card__title">{resource.title}</h3>
          <p class="resource-card__body">{resource.body}</p>
          <a href={pageUrl(resource.key, partner)} class="btn btn--outline-navy resource-card__cta">
            {resource.cta}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-faq-note {
    margin: 20px 0 0;
    font-size: 14.5px;
    color: var(--color-on-dark-muted);
  }

  .hero-faq-link {
    color: var(--color-gold-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 44px;
    align-items: start;
  }

  .contact-intro {
    margin-bottom: 24px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 24px;
  }

  .contact-detail-card {
    padding: 18px 20px;
  }

  .detail-heading {
    margin: 0 0 6px;
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--color-navy);
  }

  .detail-text {
    margin: 0;
    font-size: 14.5px;
    color: var(--color-text-muted);
  }

  .detail-link {
    color: var(--color-navy);
    font-weight: 600;
  }

  .newsletter-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .newsletter-lead {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .newsletter-form,
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-panel__title {
    margin: 0 0 6px;
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--color-navy);
  }

  .form-panel__lead {
    margin: 0 0 20px;
    font-size: 14.5px;
    color: var(--color-text-muted);
  }

  .attribution-note {
    margin-bottom: 18px;
    background: var(--color-cream);
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field-label {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-navy);
  }

  .field-control {
    width: 100%;
    padding: 11px 12px;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-navy);
    background: var(--color-white);
    border: 1px solid #768092;
    border-radius: var(--radius-sm);
  }

  .field-control:focus {
    border-color: var(--color-navy);
  }

  .pending-notice {
    background: var(--color-cream);
    font-size: 13.5px;
  }

  .form-submit {
    width: 100%;
  }

  .resources-title {
    margin-bottom: 24px;
  }

  .resource-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .resource-card__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 19px;
    color: var(--color-navy);
  }

  .resource-card__body {
    margin: 0 0 8px;
    font-size: 14px;
    color: var(--color-text-muted);
    flex-grow: 1;
  }

  .resource-card__cta {
    width: 100%;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
