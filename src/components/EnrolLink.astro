---
import { enrolmentUrl } from '../lib/links.mjs';

interface Props {
  destination: string;
  partner?: { slug: string; referralCode?: string; isFixture?: boolean; isPreview?: boolean } | null;
  label: string;
  class?: string;
  newTab?: boolean;
  hint?: string;
}

const {
  destination,
  partner = null,
  label,
  class: className = '',
  newTab = true,
  hint,
} = Astro.props;

// Always resolve through the shared helper so missing partner attribution fails the build.
const fixture = import.meta.env.DEV && (partner?.isFixture === true || partner?.isPreview === true);
const resolvedHref = fixture ? undefined : enrolmentUrl(destination, partner);
---

{fixture ? <span class={className} aria-disabled="true">{label} (test only)</span> : <a
  href={resolvedHref}
  class={className}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener noreferrer' : undefined}
>
  {label}{hint && <span class="sr-only"> — {hint}</span>}{newTab &&<span class="sr-only"> (opens in a new tab)</span>}
</a>}

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
