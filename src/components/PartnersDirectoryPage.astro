---
import { DIRECTORY_PAGE } from '../content/pages.mjs';
import { CONTINUING_EDUCATION_NOTICE } from '../content/site.mjs';
import { pageUrl } from '../lib/links.mjs';
import PageHero from './PageHero.astro';

interface Props {
  partners: Array<{
    slug: string;
    name: string;
    type: 'individual' | 'organisation';
    role: string;
    location: string;
    approvalDate: string;
    status: string;
  }>;
}

const { partners = [] } = Astro.props;
const approvedPartners = partners.filter((p) => p.status === 'live');
---

<PageHero
  eyebrow={DIRECTORY_PAGE.hero.eyebrow}
  title={DIRECTORY_PAGE.hero.title}
  lead={DIRECTORY_PAGE.hero.lead}
/>

<section class="band band--sand band--compact" aria-label="Student protection notice">
  <div class="container">
    <div class="callout-box">
      <strong>Verification &amp; Tuition Policy:</strong> {CONTINUING_EDUCATION_NOTICE.directoryNotice}
    </div>
  </div>
</section>

<section class="band band--white" aria-labelledby="directory-list-heading">
  <div class="container">
    <h2 id="directory-list-heading" class="section-heading directory-heading">
      Verified Partner Directory
    </h2>

    {approvedPartners.length === 0 ? (
      <div class="editorial-card editorial-card--cream empty-state">
        <h3 class="empty-state__title">{DIRECTORY_PAGE.emptyHeading}</h3>
        <p class="empty-state__body">{DIRECTORY_PAGE.emptyBody}</p>
      </div>
    ) : (
      <div class="editorial-grid-3 directory-grid">
        {approvedPartners.map((partner) => (
          <article class="editorial-card editorial-card--cream partner-dir-card">
            <p class="section-eyebrow">
              {partner.type === 'organisation' ? 'Organisation Partner' : 'Individual Partner'}
            </p>
            <h3 class="partner-dir-card__name">{partner.name}</h3>
            <p class="partner-dir-card__role">{partner.role}</p>
            <dl class="partner-dir-meta">
              <div>
                <dt>Location</dt>
                <dd>{partner.location}</dd>
              </div>
              <div>
                <dt>Approved</dt>
                <dd>{partner.approvalDate}</dd>
              </div>
            </dl>
            <div class="partner-dir-links">
              <a href={pageUrl('', partner)} class="btn btn--gold partner-dir-cta">
                Visit partner site
              </a>
              <a href={pageUrl('about-partner', partner)} class="partner-dir-profile">
                View partner profile
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .directory-heading {
    margin-bottom: 24px;
  }

  .empty-state {
    max-width: 720px;
  }

  .empty-state__title {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-size: 21px;
    color: var(--color-navy);
  }

  .empty-state__body {
    margin: 0;
    font-size: 15px;
    line-height: 1.62;
    color: var(--color-text-muted);
  }

  .partner-dir-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .partner-dir-card__name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 21px;
    color: var(--color-navy);
    overflow-wrap: anywhere;
  }

  .partner-dir-card__role {
    margin: 0;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .partner-dir-meta {
    margin: 6px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13.5px;
  }

  .partner-dir-meta div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  .partner-dir-meta dt {
    color: var(--color-text-muted);
  }

  .partner-dir-meta dd {
    margin: 0;
    font-weight: 600;
    color: var(--color-navy);
    text-align: right;
  }

  .partner-dir-links {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .partner-dir-cta {
    width: 100%;
  }

  .partner-dir-profile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
